---
// "Join with coaching" lands here: pay £1,297 in one go, or £397 today then 9 monthly payments of £100.
// Each button starts Stripe Checkout through a Netlify function (netlify/functions/coaching-*.mjs).
import Base from '../../layouts/Base.astro';
---
<Base title="Join with coaching" description="Choose how to pay for At your pace with coaching." noindex>
  <section class="choose">
    <p class="kicker">At your pace with coaching</p>
    <h1>How would you like to pay?</h1>
    <p class="lede">Same programme, same coaching, same price either way.</p>

    <div class="options">
      <article class="option">
        <h2>Pay in full</h2>
        <p class="price">£1,297 <span>today</span></p>
        <ol class="schedule" aria-label="Payment schedule">
          <li><span>Today</span><strong>£1,297</strong></li>
          <li><span>Later payments</span><strong>None</strong></li>
          <li class="total"><span>Total</span><strong>£1,297</strong></li>
        </ol>
        <p class="when">One payment, nothing more to pay.</p>
        <a class="btn btn--primary" href="/pay/coaching-full" rel="nofollow">Pay £1,297</a>
      </article>

      <article class="option">
        <h2>Spread the cost</h2>
        <p class="price">£397 <span>today</span></p>
        <ol class="schedule" aria-label="Payment schedule">
          <li><span>Today</span><strong>£397</strong></li>
          <li><span>Monthly, <span data-month="1">in 1 month</span> to <span data-month="9">in 9 months</span></span><strong>9 × £100</strong></li>
          <li class="total"><span>Total</span><strong>£1,297</strong></li>
        </ol>
        <p class="when">No interest, no extra charge.</p>
        <a class="btn btn--primary" href="/pay/coaching-plan" rel="nofollow">Pay £397 today</a>
      </article>
    </div>

    <div class="notes">
      <p><strong>30-day coaching guarantee.</strong> Complete Module 0 and attend your onboarding call. If the coaching still isn’t right for you, email us within 30 days of joining and we’ll refund your coaching fee of £900. You keep At your pace for the rest of your 12 months. If you’re paying in instalments, we refund anything you’ve paid above £397 and cancel the payments still to come. <a href="/#guarantee">How the guarantee works</a>.</p>
      <p><strong>Paying off high-interest debt?</strong> Please don’t put this on a credit card. Start with <a href="/#pricing">At your pace</a> and focus on Module 2 first. You can move up to coaching later.</p>
      <p class="small">Payments are handled securely by Stripe. By continuing you agree to our <a href="/terms">Terms and conditions</a>.</p>
    </div>

    <a class="back" href="/#pricing">Back to all options</a>
  </section>
</Base>

<script>
  // Show the real dates of the first and last monthly payments (the same day each month; short months use their last day)
  const fmt = new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long' });
  const today = new Date();
  document.querySelectorAll<HTMLElement>('[data-month]').forEach((el) => {
    const n = Number(el.dataset.month);
    if (!n) return;
    const d = new Date(today.getFullYear(), today.getMonth() + n, 1);
    d.setDate(Math.min(today.getDate(), new Date(d.getFullYear(), d.getMonth() + 1, 0).getDate()));
    el.textContent = fmt.format(d);
  });
</script>

<style>
  .choose { max-width: 880px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  .kicker { margin: 0 0 12px; font-size: 0.85rem; font-weight: var(--w-bold); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--terracotta-dark); }
  h1 { margin: 0 0 14px; font-family: var(--font-body); font-weight: var(--w-bold); letter-spacing: var(--track-display); font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); }
  .lede { margin: 0 0 44px; font-size: 1.25rem; color: var(--muted); }

  .options { display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); gap: 24px; align-items: stretch; }
  .option { display: flex; flex-direction: column; background: var(--cream); border-radius: 22px; padding: clamp(24px, 3vw, 36px); box-shadow: var(--lift); }
  h2 { margin: 0; font-family: var(--font-body); font-weight: var(--w-medium); font-size: 1.1rem; color: var(--ink); }
  .price { margin: 14px 0 8px; font-weight: var(--w-bold); letter-spacing: var(--track-display); font-size: clamp(2.6rem, 4vw, 3.4rem); line-height: 1; color: var(--teal-dark); }
  .price span { font-size: 0.4em; letter-spacing: 0; color: var(--muted); }
  .when { margin: 0 0 24px; color: var(--muted); }

  .schedule { list-style: none; margin: 8px 0 14px; padding: 0; display: grid; }
  .schedule li { display: flex; justify-content: space-between; gap: 16px; padding: 9px 0; border-bottom: 1px solid rgb(31 38 36 / 0.12); color: var(--muted); }
  .schedule strong { font-weight: var(--w-medium); color: var(--ink); font-variant-numeric: tabular-nums; white-space: nowrap; }
  .schedule [data-month] { white-space: nowrap; } /* keep each date on one line */
  .schedule .total { border-bottom: 0; color: var(--ink); font-weight: var(--w-medium); }

  /* Buttons sit on the bottom edge so they line up across the two cards */
  .btn { margin-top: auto; align-self: flex-start; padding-inline: 1.4em; }

  .notes { margin: 40px 0 0; display: grid; gap: 14px; max-width: 680px; }
  .notes p { margin: 0; color: var(--muted); line-height: 1.6; }
  .notes strong { color: var(--ink); font-weight: var(--w-medium); }
  .notes a, .back { color: var(--terracotta-dark); text-underline-offset: 3px; }
  .notes .small { font-size: 0.9rem; }
  .back { display: inline-block; margin-top: 28px; font-weight: var(--w-medium); }

  @media (max-width: 760px) {
    .choose { padding-inline: 24px; }
    h1 { font-size: 32px; margin-bottom: 12px; }
    .lede { font-size: 18px; margin-bottom: 32px; }
    .options { grid-template-columns: 1fr; gap: 20px; }
    .option { padding: 28px; }
    .btn { align-self: stretch; justify-content: center; }
  }
</style>
