---
import Base from '../layouts/Base.astro';
import SignupForm from '../components/SignupForm.astro';
import site from '../data/site.json';
---
<Base title="About" description={`About ${site.owner}`}>
  <section class="section">
    <div class="container grid">
      <div class="prose">
        <p class="eyebrow">About</p>
        <h1>{site.about.heading}</h1>
        {site.about.body.split(/\n\n+/).map((para) => <p>{para}</p>)}
      </div>
      {site.about.photo && <img class="photo" src={site.about.photo} alt={site.owner} />}
    </div>
  </section>
  <section class="section section--cream">
    <div class="container narrow">
      <h2>Start with the free guide</h2>
      <SignupForm source="about" />
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: start; }
  .photo { border-radius: var(--radius); }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } }
</style>
