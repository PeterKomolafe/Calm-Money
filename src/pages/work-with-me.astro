---
import Base from '../layouts/Base.astro';
import OfferCard from '../components/OfferCard.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';
const offers = (await getCollection('offers', (o) => !o.data.draft)).sort((a, b) => a.data.order - b.data.order);
---
<Base title="Work with me" description="Money coaching options with Peter Komolafe.">
  <section class="section">
    <div class="container">
      <p class="eyebrow">Work with me</p>
      <h1>Coaching that meets you where you are.</h1>
      <p class="lead">Choose the level of support that suits you. Not sure which? Start with the free guide or email {site.email}.</p>
      <div class="offers">{offers.map((o) => <OfferCard offer={o} />)}</div>
      <p class="note">{site.disclaimer}</p>
    </div>
  </section>
</Base>

<style>
  .offers { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin: 40px 0; }
  .note { font-size: 0.9rem; color: var(--muted); max-width: 80ch; }
</style>
