---
import Base from '../layouts/Base.astro';
import Logo from '../components/Logo.astro';
import SignupForm from '../components/SignupForm.astro';
import OfferCard from '../components/OfferCard.astro';
import { getCollection } from 'astro:content';
import site from '../data/site.json';

const offers = (await getCollection('offers', (o) => !o.data.draft)).sort((a, b) => a.data.order - b.data.order);
const testimonials = (await getCollection('testimonials', (t) => t.data.permission_confirmed))
  .sort((a, b) => a.data.order - b.data.order)
  .slice(0, 3);
const posts = (await getCollection('posts', (p) => !p.data.draft))
  .sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf())
  .slice(0, 3);
const { hero, lead_magnet: lm } = site;
---
<Base>
  <section class="section hero">
    <div class="container hero-grid">
      <div>
        <p class="eyebrow">{hero.eyebrow}</p>
        <h1>{hero.heading}</h1>
        <p class="lead">{hero.subheading}</p>
        <div class="btn-row">
          <a class="btn btn--primary" href="/free-guide">{hero.primary_cta}</a>
          <a class="btn btn--ghost" href="/work-with-me">{hero.secondary_cta}</a>
        </div>
      </div>
      <div class="hero-mark" aria-hidden="true"><Logo size={360} title="" /></div>
    </div>
  </section>

  <section class="section section--teal" id="guide">
    <div class="container guide-grid">
      <div>
        <p class="eyebrow on-teal">Free guide</p>
        <h2>{lm.title}</h2>
        <p>{lm.summary}</p>
        <ul class="ticks on-teal">{lm.bullets.map((b) => <li>{b}</li>)}</ul>
      </div>
      <div class="card guide-card">
        <SignupForm source="home" />
      </div>
    </div>
  </section>

  {offers.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">Work with me</p>
        <h2>Ready for more than a guide?</h2>
        <div class="offers">{offers.map((o) => <OfferCard offer={o} />)}</div>
      </div>
    </section>
  )}

  {testimonials.length > 0 && (
    <section class="section section--cream">
      <div class="container">
        <p class="eyebrow">Client stories</p>
        <div class="quotes">
          {testimonials.map((t) => (
            <figure class="card">
              <blockquote>"{t.data.quote}"</blockquote>
              <figcaption>{t.data.name}{t.data.role && <span>, {t.data.role}</span>}</figcaption>
            </figure>
          ))}
        </div>
      </div>
    </section>
  )}

  <section class="section section--cream">
    <div class="container about-strip">
      <div>
        <p class="eyebrow">About</p>
        <h2>{site.about.heading}</h2>
        <p>{site.about.body}</p>
        <a href="/about">More about me</a>
      </div>
      {site.youtube_url && (
        <div class="card">
          <h3>Watch Conversation of Money</h3>
          <p>Free, honest conversations about money on YouTube.</p>
          <a class="btn btn--ghost" href={site.youtube_url} rel="noopener">Visit the channel</a>
        </div>
      )}
    </div>
  </section>

  {posts.length > 0 && (
    <section class="section">
      <div class="container">
        <p class="eyebrow">From the blog</p>
        <div class="posts">
          {posts.map((p) => (
            <a class="card post" href={`/blog/${p.id}`}>
              <h3>{p.data.title}</h3>
              <p>{p.data.description}</p>
            </a>
          ))}
        </div>
      </div>
    </section>
  )}
</Base>

<style>
  .hero-grid { display: grid; grid-template-columns: 1.3fr 1fr; gap: 48px; align-items: center; }
  .hero-mark { display: flex; justify-content: center; }
  .hero-mark :global(svg) { width: 100%; max-width: 360px; height: auto; }
  .guide-grid { display: grid; grid-template-columns: 1fr 1fr; gap: 48px; align-items: center; }
  .on-teal { color: var(--cream); }
  .ticks.on-teal li::before { border-color: var(--blush); }
  .guide-card { color: var(--ink); }
  .offers, .quotes, .posts { display: grid; grid-template-columns: repeat(auto-fit, minmax(280px, 1fr)); gap: 24px; margin-top: 24px; }
  .about-strip { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  blockquote { margin: 0 0 1em; font-family: var(--font-display); font-size: 1.15rem; }
  figure { margin: 0; }
  figcaption { font-weight: 600; color: var(--teal); }
  .post { text-decoration: none; color: inherit; }
  .post:hover h3 { color: var(--terracotta); }
  @media (max-width: 820px) {
    .hero-grid, .guide-grid, .about-strip { grid-template-columns: 1fr; }
    .hero-mark { order: -1; }
    .hero-mark :global(svg) { max-width: 160px; }
  }
</style>
