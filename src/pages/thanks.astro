---
import Base from '../layouts/Base.astro';
import site from '../data/site.json';
const lm = site.lead_magnet;
---
<Base title="You're in">
  <section class="section">
    <div class="container narrow">
      <p class="eyebrow">Thank you</p>
      <h1>Check your inbox.</h1>
      <p class="lead">{lm.title} is on its way. If it isn't there in a few minutes, check your spam or promotions folder.</p>
      {lm.download_url && <p><a class="btn btn--primary" href={lm.download_url}>Download it now</a></p>}
      <h2>While you wait</h2>
      <p>If you already know you want support, have a look at the ways we can work together.</p>
      <a class="btn btn--ghost" href="/work-with-me">Work with me</a>
    </div>
  </section>
</Base>
