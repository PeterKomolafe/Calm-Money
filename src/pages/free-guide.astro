---
import Base from '../layouts/Base.astro';
import SignupForm from '../components/SignupForm.astro';
import Logo from '../components/Logo.astro';
import site from '../data/site.json';
const lm = site.lead_magnet;
---
<Base title={lm.title} description={lm.summary}>
  <section class="section">
    <div class="container grid">
      <div>
        <p class="eyebrow">Free guide</p>
        <h1>{lm.title}</h1>
        <p class="lead">{lm.summary}</p>
        <ul class="ticks">{lm.bullets.map((b) => <li>{b}</li>)}</ul>
        <SignupForm source="free-guide" />
      </div>
      <div class="mark" aria-hidden="true"><Logo size={300} title="" /></div>
    </div>
  </section>
</Base>

<style>
  .grid { display: grid; grid-template-columns: 1.4fr 1fr; gap: 48px; align-items: center; }
  .mark { display: flex; justify-content: center; }
  @media (max-width: 820px) { .grid { grid-template-columns: 1fr; } .mark { display: none; } }
</style>
