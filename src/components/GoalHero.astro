---
// Goal picker + calculator hero. Each goal swaps the headline, inputs and result.
// All maths runs in the browser; nothing is sent anywhere.
const ctaHref = '#course'; // TODO: point at the course/pricing section once it exists
---
<section class="hero" data-goal="debt">
  <div class="wrap">
    <fieldset class="picker">
      <legend class="picker-label">What's your goal?</legend>
      <label class="goal" style="--accent: var(--terracotta)">
        <input type="radio" name="goal" value="debt" checked />
        <span>Get debt free</span>
      </label>
      <label class="goal" style="--accent: var(--sage)">
        <input type="radio" name="goal" value="secure" />
        <span>Get financially secure</span>
      </label>
      <label class="goal" style="--accent: var(--teal)">
        <input type="radio" name="goal" value="wealth" />
        <span>Build wealth</span>
      </label>
    </fieldset>

    <!-- Get debt free -->
    <div class="panel" data-panel="debt">
      <h1>What's the exact month you'll be <em>debt free?</em></h1>
      <p class="sub">Put in your numbers. We'll show you the month your last payment lands. Then we'll show you how to pull it closer.</p>
      <div class="card">
        <p class="sentence">
          I owe <span class="field">£<input data-k="owe" inputmode="decimal" value="8,500" aria-label="Total debt in pounds" /></span>
          at <span class="field short"><input data-k="apr" inputmode="decimal" value="22" aria-label="Interest rate, APR percent" />%</span> APR,
          and I can pay <span class="field">£<input data-k="pay" inputmode="decimal" value="300" aria-label="Monthly payment in pounds" /></span> a month.
        </p>
        <div class="result" aria-live="polite">
          <p class="result-label">You're debt free in</p>
          <p class="result-date" data-out>&nbsp;</p>
          <p class="result-note" data-note></p>
        </div>
        <p class="fine">Assumes a fixed interest rate and no new borrowing. An estimate only.</p>
      </div>
    </div>

    <!-- Get financially secure -->
    <div class="panel" data-panel="secure" hidden>
      <h1>What's the exact month you'll have <em>breathing space?</em></h1>
      <p class="sub">An emergency fund is what turns a surprise bill into an inconvenience instead of a crisis. Find out when yours is ready.</p>
      <div class="card">
        <p class="sentence">
          My essentials cost <span class="field">£<input data-k="essentials" inputmode="decimal" value="1,800" aria-label="Monthly essential costs in pounds" /></span> a month.
          I have <span class="field">£<input data-k="saved" inputmode="decimal" value="1,000" aria-label="Savings so far in pounds" /></span> saved,
          and I can add <span class="field">£<input data-k="add" inputmode="decimal" value="250" aria-label="Monthly saving in pounds" /></span> a month.
        </p>
        <div class="toggle" role="radiogroup" aria-label="Size of emergency fund">
          <label><input type="radio" name="months" value="3" checked /> <span>3 months</span></label>
          <label><input type="radio" name="months" value="6" /> <span>6 months</span></label>
        </div>
        <div class="result" aria-live="polite">
          <p class="result-label" data-label>You have 3 months of breathing space in</p>
          <p class="result-date" data-out>&nbsp;</p>
          <p class="result-note" data-note></p>
        </div>
        <p class="fine">Based on your essential monthly costs. An estimate only.</p>
      </div>
    </div>

    <!-- Build wealth -->
    <div class="panel" data-panel="wealth" hidden>
      <h1>What's the exact month you'll have <em>£100,000?</em></h1>
      <p class="sub">Put in two numbers. We'll show you the month you cross £100,000. Then we'll show you how to pull it closer.</p>
      <div class="card">
        <p class="sentence">
          I have <span class="field">£<input data-k="invested" inputmode="decimal" value="10,000" aria-label="Amount invested in pounds" /></span> invested,
          and I can add <span class="field">£<input data-k="add" inputmode="decimal" value="400" aria-label="Monthly amount added in pounds" /></span> a month.
        </p>
        <div class="result" aria-live="polite">
          <p class="result-label">You cross £100,000 in</p>
          <p class="result-date" data-out>&nbsp;</p>
          <p class="result-note" data-note></p>
        </div>
        <p class="fine">Illustration only. Assumes 5% growth a year after fees, which is not guaranteed. The value of investments can go down as well as up and you may get back less than you put in. This is not financial advice.</p>
      </div>
    </div>

    <div class="hook">
      <p>That's your <strong>starting</strong> date. Calm Money shows you how to move it closer.</p>
      <a class="btn btn--primary" href={ctaHref}>Show me how</a>
    </div>
  </div>
</section>

<script>
  const GROWTH = 0.05; // assumed yearly growth for the wealth illustration
  const WEALTH_TARGET = 100_000;
  const MAX_MONTHS = 50 * 12;

  const hero = document.querySelector<HTMLElement>('.hero')!;
  const fmtDate = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });

  const num = (panel: Element, k: string) => {
    const el = panel.querySelector<HTMLInputElement>(`[data-k="${k}"]`)!;
    const n = parseFloat(el.value.replace(/[^0-9.]/g, ''));
    return Number.isFinite(n) ? n : 0;
  };
  const inMonths = (n: number) => {
    const d = new Date();
    d.setDate(1);
    d.setMonth(d.getMonth() + n);
    return fmtDate.format(d);
  };
  const span = (n: number) => {
    const y = Math.floor(n / 12), m = n % 12;
    const parts = [];
    if (y) parts.push(`${y} year${y > 1 ? 's' : ''}`);
    if (m) parts.push(`${m} month${m > 1 ? 's' : ''}`);
    return parts.join(' and ') || 'this month';
  };

  type Result = { date: string; note: string };

  const calc: Record<string, (p: Element) => Result> = {
    debt(p) {
      const owe = num(p, 'owe'), pay = num(p, 'pay'), r = num(p, 'apr') / 100 / 12;
      if (owe <= 0) return { date: 'Already there', note: 'No debt to clear. Nice.' };
      if (pay <= owe * r) return { date: 'Not yet', note: `At this payment the interest (about £${Math.round(owe * r)} a month) keeps pace with you. Try a higher monthly payment.` };
      const n = r === 0 ? Math.ceil(owe / pay) : Math.ceil(-Math.log(1 - (r * owe) / pay) / Math.log(1 + r));
      if (n > MAX_MONTHS) return { date: 'Over 50 years', note: 'Try a higher monthly payment.' };
      const interest = Math.max(0, Math.round(pay * n - owe));
      return { date: inMonths(n), note: `That's ${span(n)} away, with roughly £${interest.toLocaleString('en-GB')} paid in interest.` };
    },
    secure(p) {
      const months = Number(p.querySelector<HTMLInputElement>('input[name="months"]:checked')!.value);
      p.querySelector('[data-label]')!.textContent = `You have ${months} months of breathing space in`;
      const target = num(p, 'essentials') * months, saved = num(p, 'saved'), add = num(p, 'add');
      if (target <= 0) return { date: ' ', note: 'Add your monthly essentials to see your date.' };
      if (saved >= target) return { date: 'Already there', note: `You already have ${months} months covered.` };
      if (add <= 0) return { date: 'Not yet', note: 'Add something each month to get a date.' };
      const n = Math.ceil((target - saved) / add);
      if (n > MAX_MONTHS) return { date: 'Over 50 years', note: 'Try a higher monthly amount.' };
      return { date: inMonths(n), note: `Your target is £${Math.round(target).toLocaleString('en-GB')}. That's ${span(n)} away.` };
    },
    wealth(p) {
      let bal = num(p, 'invested');
      const add = num(p, 'add'), g = Math.pow(1 + GROWTH, 1 / 12) - 1;
      if (bal >= WEALTH_TARGET) return { date: 'Already there', note: 'You have already crossed £100,000.' };
      let n = 0;
      while (bal < WEALTH_TARGET && n <= MAX_MONTHS) { bal = bal * (1 + g) + add; n++; }
      if (n > MAX_MONTHS) return { date: 'Over 50 years', note: 'Try a higher monthly amount.' };
      return { date: inMonths(n), note: `That's ${span(n)} away.` };
    },
  };

  const update = () => {
    const goal = hero.dataset.goal!;
    const panel = hero.querySelector(`[data-panel="${goal}"]`)!;
    const { date, note } = calc[goal](panel);
    panel.querySelector('[data-out]')!.textContent = date;
    panel.querySelector('[data-note]')!.textContent = note;
  };

  hero.querySelectorAll<HTMLInputElement>('input[name="goal"]').forEach((r) =>
    r.addEventListener('change', () => {
      hero.dataset.goal = r.value;
      hero.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== r.value));
      update();
    }),
  );
  // Grow each inline field to fit its number
  const fit = (el: HTMLInputElement) => (el.style.width = `${Math.max(el.value.length, 1) + 0.3}ch`);
  hero.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((el) => {
    fit(el);
    el.addEventListener('input', () => fit(el));
  });
  hero.querySelectorAll<HTMLInputElement>('input[data-k], input[name="months"]').forEach((el) => {
    el.addEventListener('input', update);
    el.addEventListener('change', update);
  });
  // Tidy number formatting when leaving a field
  hero.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((el) =>
    el.addEventListener('blur', () => {
      const n = parseFloat(el.value.replace(/[^0-9.]/g, ''));
      el.value = Number.isFinite(n) ? n.toLocaleString('en-GB', { maximumFractionDigits: 2 }) : '0';
      fit(el);
    }),
  );
  update();
</script>

<style>
  .hero { padding: clamp(48px, 9vw, 120px) 0 clamp(64px, 10vw, 128px); }
  .wrap { max-width: 920px; margin: 0 auto; padding: 0 var(--gutter); }

  /* Goal picker: each goal borrows one logo colour as its accent */
  .picker { border: 0; padding: 0; margin: 0 0 clamp(32px, 5vw, 56px); display: flex; flex-wrap: wrap; gap: 10px; }
  .picker-label { width: 100%; padding: 0; margin-bottom: 14px; font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  .goal { position: relative; cursor: pointer; }
  .goal input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .goal span {
    display: inline-flex; align-items: center; gap: 10px;
    padding: 0.7em 1.25em; border: 1.5px solid var(--line); border-radius: 999px;
    font-weight: 600; color: var(--ink); background: #fff;
    transition: border-color 0.15s, box-shadow 0.15s;
  }
  .goal span::before { content: ''; width: 10px; height: 10px; border-radius: 50%; background: var(--accent); }
  .goal input:checked + span { border-color: var(--accent); box-shadow: 0 0 0 3px color-mix(in srgb, var(--accent) 22%, transparent); }
  .goal input:focus-visible + span { outline: 3px solid var(--terracotta-dark); outline-offset: 3px; }

  h1 { font-size: clamp(2.5rem, 7vw, 5rem); line-height: 1.02; color: var(--ink); margin-bottom: 0.35em; }
  h1 em { font-style: italic; color: var(--terracotta); }
  .sub { font-size: clamp(1.05rem, 2vw, 1.3rem); color: var(--muted); max-width: 44ch; margin-bottom: clamp(32px, 5vw, 48px); }

  .card { border: 1px solid var(--line); border-radius: 24px; padding: clamp(24px, 4vw, 44px); background: #fff; box-shadow: 0 1px 2px rgb(0 0 0 / 0.03), 0 12px 40px rgb(31 38 36 / 0.05); }
  .sentence { font-size: clamp(1.2rem, 2.8vw, 1.75rem); line-height: 2; margin: 0; }
  .field { display: inline-flex; align-items: baseline; border-bottom: 2px solid var(--terracotta); color: var(--terracotta-dark); font-weight: 700; padding: 0 0.15em; }
  .field input { font: inherit; color: inherit; border: 0; background: transparent; width: 6ch; min-width: 1.3ch; padding: 0; font-variant-numeric: tabular-nums; }
  .field input:focus { outline: none; }
  .field:focus-within { background: color-mix(in srgb, var(--blush) 22%, transparent); border-radius: 6px 6px 0 0; }

  .toggle { display: inline-flex; margin-top: 20px; border: 1.5px solid var(--line); border-radius: 999px; padding: 4px; }
  .toggle label { position: relative; cursor: pointer; }
  .toggle input { position: absolute; opacity: 0; inset: 0; margin: 0; cursor: pointer; }
  .toggle span { display: block; padding: 0.4em 1em; border-radius: 999px; font-weight: 600; font-size: 0.95rem; color: var(--muted); }
  .toggle input:checked + span { background: var(--sage); color: #fff; }
  .toggle input:focus-visible + span { outline: 3px solid var(--terracotta-dark); outline-offset: 2px; }

  .result { border-top: 1px dashed var(--line); margin-top: clamp(24px, 4vw, 36px); padding-top: clamp(24px, 4vw, 36px); }
  .result-label { font-size: 0.8rem; font-weight: 700; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); margin: 0 0 6px; }
  .result-date { font-family: var(--font-display); font-size: clamp(2.4rem, 7vw, 4.25rem); line-height: 1.05; color: var(--teal-dark); margin: 0 0 10px; }
  .result-note { color: var(--muted); margin: 0; }
  .fine { font-size: 0.8rem; color: var(--muted); margin: 20px 0 0; }

  .hook { display: flex; flex-wrap: wrap; align-items: center; justify-content: space-between; gap: 16px 24px; margin-top: clamp(28px, 4vw, 40px); }
  .hook p { font-size: 1.15rem; margin: 0; }
  .hook strong { color: var(--terracotta-dark); }
</style>
