---
// A slim 'As featured on' strip under Peter's name in the hero, so the press credibility lands in the first screen.
import { featured, logoHeight } from '../data/featured';
---
<div class="press" role="group" aria-label="As featured on">
  <p>As featured on</p>
  <ul>
    {featured.map(([file, name, w, h]) => (
      <li><img src={`/images/featured/${file}.png`} width={w} height={h} alt={name} loading="lazy" style={`--h: ${logoHeight(file, w, h)}px`} /></li>
    ))}
  </ul>
</div>

<style>
  .press { position: relative; z-index: 2; max-width: 820px; margin: 0 auto; padding: 0 28px; text-align: center; }
  p { margin: 0 0 12px; font-size: 0.75rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px clamp(20px, 2.6vw, 34px); }
  img { display: block; width: auto; height: var(--h); opacity: 0.9; }
  @media (max-width: 760px) {
    .press { padding-inline: 24px; margin-top: 12px; }
    /* Five across, so the nine logos sit as 5 and 4 rather than leaving one or two alone on a row */
    ul { gap: 14px 0; }
    li { flex: 0 0 20%; display: flex; justify-content: center; }
    img { height: calc(var(--h) * 0.62); max-width: 90%; object-fit: contain; }
  }
</style>
