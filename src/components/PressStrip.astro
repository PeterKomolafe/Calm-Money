---
// A slim 'As featured on' strip under the hero's button and byline, so the press credibility lands in the first screen.
import { featured, logoHeight } from '../data/featured';
// tone 'mono' shows the logos in grey, so they sit quietly under the hero
interface Props { tone?: 'colour' | 'mono' }
const { tone = 'colour' } = Astro.props;
---
<div class:list={['press', tone]} role="group" aria-label="As featured on">
  <p>As featured on</p>
  <ul>
    {featured.map(([file, name, w, h]) => (
      <li><img src={`/images/featured/${file}.png`} width={w} height={h} alt={name} loading="lazy" style={`--h: ${logoHeight(file, w, h)}px`} /></li>
    ))}
  </ul>
</div>

<style>
  .press { position: relative; z-index: 2; max-width: 820px; margin: 0 auto; padding: 0 28px; text-align: center; }
  p { margin: 0 0 12px; font-size: 0.75rem; font-weight: var(--w-bold); letter-spacing: var(--track-label); text-transform: uppercase; color: var(--muted); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 14px clamp(20px, 2.6vw, 34px); }
  img { display: block; width: auto; height: var(--h); opacity: 0.9; }
  .mono img { filter: grayscale(1); opacity: 0.55; }
  @media (max-width: 760px) {
    .press { padding-inline: 24px; margin-top: 12px; }
    /* All six on one row, spread across the width */
    ul { flex-wrap: nowrap; justify-content: space-between; gap: 10px; }
    li { flex: 0 1 auto; min-width: 0; display: flex; justify-content: center; }
    img { height: calc(var(--h) * 0.7); max-width: 100%; object-fit: contain; }
  }
</style>
