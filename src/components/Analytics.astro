---
import site from '../data/site.json';
// Cookie-free visitor stats with Umami Cloud (free Hobby plan). Nothing is stored on the visitor's device
// and no personal data is collected, so there's no consent banner. Paste the Website ID from Umami's
// website settings into umami_website_id in src/data/site.json; while it's empty, nothing loads.
// The free plan counts each event property as an event, so properties are kept to the useful few.
//
// Events sent:
//   Join click       which section, and the button's words
//   Calculator used  first change to the calculator, with the goal
//   Result emailed   the calculator result email was sent, with the goal
//   Waitlist joined  someone joined the full support waitlist
//   Video played     the intro video was started
//   Compare opened   the pricing comparison table was opened
const id = site.umami_website_id;
---
{id && (
  <>
    <script defer src="https://cloud.umami.is/script.js" data-website-id={id}></script>
    <script is:inline define:vars={{ joinUrl: site.join_url }}>
      (() => {
        const track = (name, data) => window.umami?.track(name, data);
        window.calmTrack = track;
        const section = (el) => (el.closest('section, header')?.className || 'page').split(' ')[0];

        document.addEventListener('click', (e) => {
          const a = e.target.closest && e.target.closest('a[href]');
          if (a && a.href === joinUrl) track('Join click', { where: section(a), button: a.textContent.trim() });
        });

        document.addEventListener('toggle', (e) => {
          if (e.target.matches && e.target.matches('details.compare') && e.target.open) track('Compare opened');
        }, true);

        // The video plays inside Bunny's player, so a click on it shows up as the page losing focus to it
        let played = false;
        window.addEventListener('blur', () => setTimeout(() => {
          if (!played && document.activeElement?.closest?.('.intro')) { played = true; track('Video played'); }
        }));
      })();
    </script>
  </>
)}
