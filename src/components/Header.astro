---
import Logo from './Logo.astro';
import site from '../data/site.json';

const links = [
  { href: '/work-with-me', label: 'Work with me' },
  { href: '/about', label: 'About' },
  { href: '/blog', label: 'Blog' },
];
const path = Astro.url.pathname;
---
<header class="site-header">
  <div class="container bar">
    <a class="brand" href="/">
      <Logo size={34} />
      <span>{site.name}</span>
    </a>
    <nav aria-label="Main">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} aria-current={path.startsWith(l.href) ? 'page' : undefined}>{l.label}</a></li>
        ))}
        <li><a class="btn btn--primary" href="/free-guide">Free guide</a></li>
      </ul>
    </nav>
  </div>
</header>

<style>
  .site-header { background: var(--paper); border-bottom: 1px solid var(--line); position: sticky; top: 0; z-index: 10; }
  .bar { display: flex; align-items: center; justify-content: space-between; gap: 16px; min-height: 72px; flex-wrap: wrap; }
  .brand { display: flex; align-items: center; gap: 10px; text-decoration: none; font-family: var(--font-display); font-size: 1.35rem; color: var(--teal-dark); }
  ul { display: flex; align-items: center; gap: clamp(12px, 2.5vw, 28px); list-style: none; margin: 0; padding: 0; flex-wrap: wrap; }
  nav a:not(.btn) { text-decoration: none; color: var(--ink); font-weight: 500; }
  nav a[aria-current='page'] { color: var(--terracotta); }
  .btn { padding: 0.6em 1.1em; }
  @media (max-width: 640px) {
    .bar { padding-top: 12px; padding-bottom: 12px; }
    nav { width: 100%; }
    ul { justify-content: space-between; gap: 10px; font-size: 0.95rem; }
  }
</style>
