---
import Logo from './Logo.astro';
import site from '../data/site.json';

// TODO: #how and #pricing sections are not built yet; those anchors are placeholders
const links = [
  { href: '/#programme', label: 'The programme' },
  { href: '/#pricing', label: 'Pricing' },
  { href: '/#faq', label: 'Questions' },
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name}, home`}><Logo size={40} title="" /></a>
  <nav aria-label="Main">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a class="join" href={site.join_url}>Join Calm Money</a>
</header>

<style>
  .site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 22px 32px; }
  .brand { display: flex; align-items: center; justify-self: start; }
  nav { display: flex; gap: 40px; }
  /* The ledger grid's centre line runs straight through the middle link, so each link sits on paper */
  nav a { color: var(--ink); text-decoration: none; background: var(--paper); padding: 4px 10px; margin: 0 -10px; }
  nav a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .join { justify-self: end; font-family: var(--font-display); font-weight: var(--w-medium); font-size: 1.2rem; color: var(--ink); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; white-space: nowrap; }
  @media (max-width: 760px) {
    .site-header { grid-template-columns: 1fr auto; padding: 16px 24px; }
    nav { display: none; }
    .join { font-size: 1.05rem; }
  }
</style>
