---
import Logo from './Logo.astro';
import site from '../data/site.json';
---
<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name}, home`}><Logo size={40} title="" /></a>
  <a class="join" href={site.join_url}>Join Calm Money</a>
</header>

<style>
  .site-header { display: flex; justify-content: space-between; align-items: center; gap: 16px; padding: 22px 32px; }
  .brand { display: flex; align-items: center; }
  .join { font-family: var(--font-display); font-weight: var(--w-medium); font-size: 1.2rem; color: var(--ink); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; white-space: nowrap; }
  @media (max-width: 760px) {
    .site-header { padding: 16px 24px; }
    .join { font-size: 1.05rem; }
  }
</style>
