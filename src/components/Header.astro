---
import Logo from './Logo.astro';
import site from '../data/site.json';

// TODO: #how and #pricing sections are not built yet; those anchors are placeholders
const links = [
  { href: '/#programme', label: 'The programme' },
  { href: '/#how', label: 'How it works' },
  { href: '/#pricing', label: 'Pricing' },
];
---
<header class="site-header">
  <a class="brand" href="/" aria-label={`${site.name}, home`}><Logo size={40} title="" /></a>
  <nav aria-label="Main">
    {links.map((l) => <a href={l.href}>{l.label}</a>)}
  </nav>
  <a class="join" href="/#pricing">Join the programme<span class="from">from £297</span></a>
</header>

<style>
  .site-header { display: grid; grid-template-columns: 1fr auto 1fr; align-items: center; gap: 16px; padding: 22px 32px; }
  .brand { display: flex; align-items: center; justify-self: start; }
  nav { display: flex; gap: 40px; }
  nav a { color: var(--ink); text-decoration: none; }
  nav a:hover { text-decoration: underline; text-underline-offset: 6px; }
  .join { justify-self: end; font-family: var(--font-display); font-size: 1.3rem; color: var(--ink); text-decoration: underline; text-underline-offset: 5px; text-decoration-thickness: 1.5px; white-space: nowrap; }
  .from { font-family: var(--font-body); font-size: 0.75rem; color: var(--muted); margin-left: 5px; vertical-align: super; display: inline-block; text-decoration: none; }
  @media (max-width: 760px) {
    .site-header { grid-template-columns: 1fr auto; padding: 16px; }
    nav { display: none; }
    .join { font-size: 1.05rem; }
  }
</style>
