---
import site from '../data/site.json';
// The money forecast: the calculator as a weather forecast. Stormy while there's debt, clearing once it's
// gone, calm with a safety net, sunny once the first £10,000 is invested (assuming 7% growth, stated in the card).
// Once one goal is reached, the same monthly amount moves on to the next. All maths runs in the browser;
// nothing is sent anywhere unless the visitor asks for their forecast by email (then it goes to Klaviyo).
---
<section class="forecast" id="calculator" data-goal="debt" data-key={site.klaviyo_public_key} data-list={site.klaviyo_calculator_list_id} aria-labelledby="forecast-h">
  <div class="intro">
    <h2 id="forecast-h">Your money forecast.</h2>
    <p class="lede">Tell us where things stand today. We’ll show you when the storm clears, when it turns calm, and when the sun comes out.</p>
  </div>

  <section class="inputs" aria-labelledby="step1">
    <div class="step-head"><h2 id="step1"><span class="step">1</span> Your numbers</h2><p>Type over any of these. Your forecast below changes as you go.</p></div>
    <!-- One sentence on wider screens; on phones each number becomes its own labelled row -->
    <p class="sentence">
      <span class="pair"><span class="m">I owe</span><span class="d">I owe </span><span class="in">£<input id="owe" inputmode="decimal" value="8,500" aria-label="Debt in pounds"></span></span>
      <span class="pair"><span class="m">Interest (APR)</span><span class="d"> at </span><span class="in"><input id="apr" inputmode="decimal" value="22" aria-label="Average APR percent">%</span><span class="d"> APR</span></span>
      <span class="pair"><span class="m">Each month I can put in</span><span class="d"> and can put </span><span class="in">£<input id="pay" inputmode="decimal" value="300" aria-label="Monthly amount in pounds"></span><span class="d"> a month towards my goals.</span></span>
      <span class="pair"><span class="m">My essentials each month</span><span class="d"> My essentials cost </span><span class="in">£<input id="ess" inputmode="decimal" value="1,800" aria-label="Monthly essentials in pounds"></span><span class="d"> a month,</span></span>
      <span class="pair"><span class="m">Saved so far</span><span class="d"> I have </span><span class="in">£<input id="saved" inputmode="decimal" value="1,000" aria-label="Savings in pounds"></span><span class="d"> saved</span></span>
      <span class="pair"><span class="m">Already invested</span><span class="d"> and </span><span class="in">£<input id="inv" inputmode="decimal" value="1,500" aria-label="Already invested in pounds"></span><span class="d"> invested.</span></span>
    </p>
  </section>

  <section class="sky" id="sky" aria-labelledby="sky-h">
    <div class="sun" id="sun"></div><div class="cloud c1" id="c1"></div><div class="cloud c2" id="c2"></div><canvas class="rain" id="rain" aria-hidden="true"></canvas>

    <div class="sky-head"><h2 id="sky-h"><span class="step">2</span> Your forecast</h2><span id="issued"></span></div>

    <!-- The answer first -->
    <div class="answer">
      <h2 class="headline" id="headline">Sunny by September 2033</h2>
      <p class="sub" id="sub"></p>
    </div>

    <div class="days" role="group" aria-label="Jump to a point in the forecast" id="days"></div>
    <p class="key">Stormy = paying off debt · Clearing = debt free · Calm = safety net in place · Sunny = investing</p>

    <!-- Look ahead: the same forecast month by month -->
    <div class="ahead">
      <div class="look">
        <div class="look-top">
          <button type="button" class="play" id="play"><span aria-hidden="true">▶</span> Play forecast</button>
          <label for="t"><span>Look ahead</span> <b id="t-out">Today</b></label>
        </div>
        <input type="range" id="t" min="0" max="83" value="0">
      </div>
      <div class="now" aria-live="polite">
        <svg id="big-icon" viewBox="0 0 48 48" aria-hidden="true"></svg>
        <div>
          <p class="cond" id="cond">Stormy</p>
          <p class="when" id="when"></p>
        </div>
      </div>
      <div class="readings">
        <div class="reading" style="--c:var(--blush)"><span>Debt left</span><b id="r-debt"></b><div class="bar"><i id="b-debt"></i></div></div>
        <div class="reading" style="--c:#a9c4b9"><span>Safety net</span><b id="r-sec"></b><div class="bar"><i id="b-sec"></i></div></div>
        <div class="reading" style="--c:#f6cda0"><span>Invested</span><b id="r-inv"></b><div class="bar"><i id="b-inv"></i></div></div>
      </div>
      <div class="warning" id="warn">
        <svg viewBox="0 0 24 24" aria-hidden="true"><path d="M12 3l10 18H2z" fill="#e6a89c"/><path d="M12 10v5M12 18v.5" stroke="#1f2624" stroke-width="2" stroke-linecap="round"/></svg>
        <p id="warn-t"></p>
      </div>
    </div>

    <!-- Want it sooner? Pick a year and see what it would take -->
    <div class="sooner" id="sooner">
      <div class="sooner-row">
        <p class="ask" id="sooner-ask">Want it sooner?</p>
        <div class="chips" role="group" aria-labelledby="sooner-ask" aria-describedby="need" id="years"></div>
      </div>
      <p class="need" id="need" aria-live="polite"></p>
    </div>
    <p class="growth">Your sunny date assumes a 7% a year investment return. This is an assumption, not a guarantee. Investments can go down as well as up.</p>
  </section>

  <section class="box" aria-labelledby="keep-h">
    <h2 id="keep-h">Email me my forecast</h2>
    <p>Your dates and the one thing to do this week, from Peter.</p>
    <form class="keep" novalidate>
      <div class="keep-row">
        <input id="keep-email" name="email" type="email" placeholder="you@example.com" autocomplete="email" aria-label="Email address" required />
        <button class="btn btn--primary" type="submit">Send it</button>
      </div>
      <label class="trap" aria-hidden="true">Leave this empty <input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
      <p class="keep-small" data-keep-msg>One email with your forecast, then occasional emails from Peter. Unsubscribe any time.</p>
    </form>
  </section>
  <p class="fine">Assumes a fixed interest rate and no new borrowing. An estimate, not financial advice.</p>

  <!-- Bridge: turns the visitor's own forecast into the case for a system -->
  <div class="bridge" aria-live="polite">
    <span class="down" style="--src: url(/images/notes/arrow.png)" aria-hidden="true"></span>
    <p class="big" data-bridge></p>
    <p class="turn" data-turn></p>
  </div>
  <div class="bridge-cta"><a class="btn btn--primary" href={site.join_url}>Join Calm Money</a></div>
</section>

<script is:inline>
(() => {
  const $ = (id) => document.getElementById(id);
  const num = (id) => { const n = parseFloat($(id).value.replace(/[^0-9.]/g, '')); return Number.isFinite(n) ? n : 0; };
  const gbp = (n) => `£${Math.round(n).toLocaleString('en-GB')}`;
  const MAX = 600, TARGET = 10000, FUND_MONTHS = 3;
  // Investment growth: 7% a year, an assumption, not a guarantee. Applied monthly to anything already invested
  const GROWTH = 0.07, g = Math.pow(1 + GROWTH, 1 / 12) - 1;
  const start = new Date(); start.setDate(1);
  const date = (n, style = 'short') => { const d = new Date(start); d.setMonth(d.getMonth() + n); return new Intl.DateTimeFormat('en-GB', { month: style, year: 'numeric' }).format(d); };
  const span = (n) => { const y = Math.floor(n / 12), m = n % 12, p = []; if (y) p.push(`${y} year${y > 1 ? 's' : ''}`); if (m) p.push(`${m} month${m > 1 ? 's' : ''}`); return p.join(' and ') || 'no time'; };
  $('issued').textContent = `Issued ${new Intl.DateTimeFormat('en-GB', { day: 'numeric', month: 'long', year: 'numeric' }).format(new Date())}`;

  // Icons, drawn in the brand's colours
  const ICON = {
    stormy: '<path d="M13 29a8 8 0 0 1 1-16 11 11 0 0 1 21 3 7 7 0 0 1-1 13z" fill="#bbb8ad"/><path d="M23 30l-4 8h5l-3 7 9-10h-5l3-5z" fill="#e6a89c"/>',
    clearing: '<circle cx="31" cy="17" r="8" fill="#f6cda0"/><path d="M11 36a7 7 0 0 1 1-14 10 10 0 0 1 19 3 6 6 0 0 1-1 11z" fill="#f5e8d8"/>',
    calm: '<defs><clipPath id="sea-cut"><rect x="0" y="0" width="48" height="27"/></clipPath></defs><circle cx="24" cy="27" r="10" fill="#f6cda0" clip-path="url(#sea-cut)"/><path d="M6 27h36" stroke="#f5e8d8" stroke-width="2.5" stroke-linecap="round"/><path d="M10 33c3-2 5-2 8 0s5 2 8 0 5-2 8 0" fill="none" stroke="#cfe0d8" stroke-width="2.5" stroke-linecap="round"/><path d="M15 39c2.5-1.6 4.5-1.6 7 0s4.5 1.6 7 0" fill="none" stroke="#cfe0d8" stroke-width="2.5" stroke-linecap="round" opacity="0.7"/>',
    sunny: '<circle cx="24" cy="24" r="9" fill="#f6cda0"/><g stroke="#f6cda0" stroke-width="3" stroke-linecap="round"><path d="M24 5v5M24 38v5M5 24h5M38 24h5M10.5 10.5l3.5 3.5M34 34l3.5 3.5M10.5 37.5l3.5-3.5M34 14l3.5-3.5"/></g>',
  };
  // Sky colours at each stage: [top, bottom]
  const SKY = { stormy: ['#343f41', '#56656a'], clearing: ['#465f61', '#7f9895'], calm: ['#4c6b67', '#7f9d91'], sunny: ['#435f5c', '#a7825e'] };
  const mix = (a, b, t) => { const p = (h) => [1, 3, 5].map((i) => parseInt(h.slice(i, i + 2), 16)); const x = p(a), y = p(b); return '#' + x.map((v, i) => Math.round(v + (y[i] - v) * t).toString(16).padStart(2, '0')).join(''); };

  const plan = (pay) => {
    const owe = num('owe'), r = Math.pow(1 + num('apr') / 100, 1 / 12) - 1;
    if (pay <= 0) return null;
    let d = 0, interest = 0;
    if (owe > 0) {
      if (pay <= owe * r) return null;
      d = r === 0 ? Math.ceil(owe / pay) : Math.ceil(-Math.log(1 - (r * owe) / pay) / Math.log(1 + r));
      let bal = owe, paid = 0; for (let i = 0; i < d; i++) { bal *= 1 + r; const x = Math.min(pay, bal); paid += x; bal -= x; } interest = paid - owe;
    }
    const fund = num('ess') * FUND_MONTHS;
    const s = d + Math.ceil(Math.max(0, fund - num('saved')) / pay);
    // Existing investments grow from today; monthly payments start going in once the safety net is in place
    let i = 0, pot = num('inv');
    while (pot < TARGET && i <= MAX) { pot *= 1 + g; if (i >= s) pot += pay; i++; }
    if (num('inv') >= TARGET) i = s;
    i = Math.max(i, s);
    if (i > MAX) return null;
    return { d, s, i, interest, fund, owe, r, pay };
  };
  // Balances at a given month
  const at = (p, n) => {
    let debt = p.owe, sec = num('saved'), inv = num('inv');
    for (let m = 0; m < n; m++) {
      let pay = p.pay;
      if (debt > 0) { debt *= 1 + p.r; const x = Math.min(pay, debt); debt -= x; pay -= x; }
      if (pay > 0 && sec < p.fund) { const x = Math.min(pay, p.fund - sec); sec += x; pay -= x; }
      inv *= 1 + g;
      if (pay > 0) inv += pay;
    }
    return { debt, sec, inv };
  };
  const stage = (p, n) => (n < p.d ? 'stormy' : n < p.s ? 'clearing' : n < p.i ? 'calm' : 'sunny');
  const NAME = { stormy: 'Stormy', clearing: 'Clearing', calm: 'Calm', sunny: 'Sunny' };

  let P = null, goalYear = 0;
  const t = $('t');

  // Rain: two layers of drops (far: thin, slow, faint; near: longer, faster), angled by a light wind.
  // How many fall follows how much debt is left. Paused when the sky is off screen.
  const rain = (() => {
    const cv = $('rain'), ctx = cv.getContext('2d');
    const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
    const WIND = 0.18, drops = [];
    let w = 0, h = 0, dpr = 1, on = false, raf = 0, api;
    const spawn = (d, top) => {
      const near = Math.random() < 0.35;
      d.near = near;
      d.len = near ? 16 + Math.random() * 14 : 7 + Math.random() * 8;
      d.speed = near ? 13 + Math.random() * 6 : 7 + Math.random() * 4;
      d.alpha = near ? 0.32 + Math.random() * 0.2 : 0.12 + Math.random() * 0.12;
      d.width = near ? 1.4 : 0.9;
      d.x = Math.random() * (w + h * WIND);
      d.y = top ? -Math.random() * h : -d.len;
      return d;
    };
    const size = () => {
      dpr = Math.min(2, window.devicePixelRatio || 1);
      w = cv.clientWidth; h = cv.clientHeight;
      cv.width = Math.round(w * dpr); cv.height = Math.round(h * dpr);
      ctx.setTransform(dpr, 0, 0, dpr, 0, 0);
      const want = Math.round((w * h) / 2600);
      while (drops.length < want) drops.push(spawn({}, true));
      drops.length = Math.min(drops.length, want);
    };
    const splashes = [];
    const frame = () => {
      ctx.clearRect(0, 0, w, h);
      const active = Math.round(drops.length * api.intensity);
      ctx.lineCap = 'round';
      for (let i = 0; i < active; i++) {
        const d = drops[i];
        if (!reduce) { d.y += d.speed; d.x -= d.speed * WIND; }
        ctx.strokeStyle = `rgba(245, 232, 216, ${d.alpha})`;
        ctx.lineWidth = d.width;
        ctx.beginPath(); ctx.moveTo(d.x, d.y); ctx.lineTo(d.x + d.len * WIND, d.y - d.len); ctx.stroke();
        if (d.y > h) {
          if (d.near && splashes.length < 40) splashes.push({ x: d.x, r: 1, a: 0.35 });
          spawn(d, false);
        }
      }
      // Small splashes where near drops land
      for (let i = splashes.length - 1; i >= 0; i--) {
        const s = splashes[i]; s.r += 0.9; s.a -= 0.03;
        if (s.a <= 0) { splashes.splice(i, 1); continue; }
        ctx.strokeStyle = `rgba(245, 232, 216, ${s.a})`; ctx.lineWidth = 1;
        ctx.beginPath(); ctx.ellipse(s.x, h - 4, s.r * 1.8, s.r * 0.5, 0, Math.PI, 2 * Math.PI); ctx.stroke();
      }
      if (on && !reduce) raf = requestAnimationFrame(frame);
    };
    const start = () => { if (on) return; on = true; cancelAnimationFrame(raf); raf = requestAnimationFrame(frame); };
    const stopRain = () => { on = false; cancelAnimationFrame(raf); };
    new ResizeObserver(() => { size(); if (reduce) frame(); }).observe(cv);
    if ('IntersectionObserver' in window) new IntersectionObserver((es) => (es[0].isIntersecting ? start() : stopRain())).observe(cv);
    else start();
    api = { intensity: 1, redraw: () => reduce && frame() };
    return api;
  })();

  const drawSky = () => {
    if (!P) return;
    const n = Number(t.value), st = stage(P, n), b = at(P, n);
    // Blend the sky within each stretch so it changes gradually as you drag
    const edges = [[0, P.d, 'stormy', 'clearing'], [P.d, P.s, 'clearing', 'calm'], [P.s, P.i, 'calm', 'sunny']];
    let top = SKY.sunny[0], bottom = SKY.sunny[1];
    for (const [a, z, from, to] of edges) if (n < z) { const k = z > a ? (n - a) / (z - a) : 1; top = mix(SKY[from][0], SKY[to][0], k * 0.6); bottom = mix(SKY[from][1], SKY[to][1], k * 0.6); break; }
    const sky = $('sky'); sky.style.setProperty('--top', top); sky.style.setProperty('--bottom', bottom);
    rain.intensity = P.owe ? Math.max(0, b.debt / P.owe) : 0; rain.redraw();
    $('c1').style.opacity = st === 'sunny' ? 0.2 : 1; $('c2').style.opacity = st === 'stormy' || st === 'clearing' ? 1 : 0.3;
    $('sun').style.opacity = st === 'sunny' ? 1 : st === 'calm' ? (n - P.s) / Math.max(1, P.i - P.s) * 0.7 : 0;

    $('warn').hidden = !P.interest || n >= P.d;
    $('big-icon').innerHTML = ICON[st];
    $('cond').textContent = NAME[st];
    const lines = {
      stormy: `${gbp(b.debt)} of debt, costing about <b>${gbp(b.debt * P.r)}</b> in interest this month.`,
      clearing: `Debt free. Every ${gbp(P.pay)} now goes into your safety net.`,
      calm: `${FUND_MONTHS} months of essentials covered. Your ${gbp(P.pay)} now goes into investments.`,
      sunny: `Your first £10,000 invested. Your money is working for you.`,
    };
    $('when').innerHTML = `<b>${n === 0 ? 'Today' : date(n, 'long')}.</b> ${lines[st]}`;
    $('r-debt').textContent = gbp(b.debt); $('r-sec').textContent = gbp(b.sec); $('r-inv').textContent = gbp(b.inv);
    $('b-debt').style.width = (P.owe ? b.debt / P.owe : 0) * 100 + '%';
    $('b-sec').style.width = Math.min(1, b.sec / P.fund) * 100 + '%';
    $('b-inv').style.width = Math.min(1, b.inv / TARGET) * 100 + '%';
    $('t-out').textContent = n === 0 ? 'Today' : date(n);
    document.querySelectorAll('.day').forEach((d) => d.setAttribute('aria-pressed', String(stage(P, Number(d.dataset.n)) === st)));
    // "Next stop" belongs to the first milestone only, and appears once the timeline reaches it
    const first = [...document.querySelectorAll('.day')].find((d) => Number(d.dataset.n) > 0);
    document.querySelectorAll('.day').forEach((d) => d.classList.toggle('next', d === first && n >= Number(d.dataset.n)));
  };

  let render = () => {
    const pay = num('pay');
    P = plan(pay);
    const sky = $('sky');
    if (!P) {
      const r = Math.pow(1 + num('apr') / 100, 1 / 12) - 1;
      $('cond').textContent = 'Stormy';
      $('big-icon').innerHTML = ICON.stormy;
      $('when').innerHTML = pay <= num('owe') * r
        ? `At ${gbp(pay)} a month, the interest (about <b>${gbp(num('owe') * r)}</b> a month) keeps pace with you. The storm won't clear on its own. Try a higher amount.`
        : 'That would take over 50 years. Try a higher monthly amount.';
      rain.intensity = 1; rain.redraw();
      $('days').innerHTML = ''; $('warn').hidden = true;
      $('headline').textContent = 'The storm won\'t clear yet'; $('sub').textContent = ''; $('sooner').hidden = true;
      sky.style.setProperty('--top', SKY.stormy[0]); sky.style.setProperty('--bottom', SKY.stormy[1]);
      return;
    }
    t.max = P.i; if (Number(t.value) > P.i) t.value = P.i;

    // A far-off sunny date can put people off, so when it's more than four years away, lead with year one
    const FAR = 48; let lead = '';
    if (P.i > FAR) {
      const y1 = at(P, Math.min(12, P.i)), saved = num('saved'), inv = num('inv');
      const win = P.owe > 0 ? `${gbp(P.owe - y1.debt)} of debt gone` : y1.sec > saved ? `${gbp(y1.sec - saved)} more in your safety net` : `${gbp(y1.inv - inv)} more invested`;
      $('headline').textContent = `In 12 months: ${win}.`;
      const first = P.owe > 0 ? `clear skies by <b>${date(P.d, 'long')}</b>` : `calm by <b>${date(P.s, 'long')}</b>`;
      lead = `Then ${first}, and sunny by ${date(P.i, 'long')}. `;
    } else {
      $('headline').textContent = `Sunny by ${date(P.i, 'long')}`;
    }
    // One line under the headline: when you get there (if the headline is about year one), then how
    $('sub').innerHTML = `${lead}Once you reach one goal, the same <b>${gbp(P.pay)} a month</b> moves on to the next.`;
    // Interest warning, while there is debt
    $('warn-t').innerHTML = `<b>About ${gbp(P.interest)}</b> goes on interest before the storm clears.`;

    // The four days of the forecast
    const days = [
      [0, P.owe ? 'stormy' : 'clearing', 'Today', P.owe ? `${gbp(P.owe)} owed` : 'No debt'],
      [P.d, 'clearing', P.d ? date(P.d) : 'Now', 'Debt free'],
      [P.s, 'calm', date(P.s), `${FUND_MONTHS}-month safety net`],
      [P.i, 'sunny', date(P.i), 'First £10,000 invested'],
    ];
    // The same four days go in the forecast email, with "Next stop" on the first milestone
    const firstN = days.find(([n]) => n > 0)?.[0];
    P.days = days.map(([n, st, d, txt]) => ({ when: d, name: NAME[st], text: txt, icon: st, next: n === firstN && n > 0 }));
    $('days').innerHTML = days.map(([n, st, d, txt], i) => `<button type="button" class="day" data-n="${n}" aria-pressed="false"><span class="flag">Next stop</span><span class="d">${d}</span><svg viewBox="0 0 48 48" aria-hidden="true">${ICON[st]}</svg><span class="w">${NAME[st]}</span><span class="t">${txt}</span></button>`).join('');


    // Want it sooner: up to three earlier years to aim for, and the monthly amount each would take
    const nowYear = start.getFullYear(), sunYear = Number(date(P.i, 'long').slice(-4));
    // Three years spread between soon and just before their current sunny year
    const lo3 = nowYear + 2, hi3 = sunYear - 1;
    const options = [...new Set([lo3, Math.round((lo3 + hi3) / 2), hi3])].filter((y) => y > nowYear && y < sunYear).sort();
    $('sooner').hidden = !options.length;
    if (options.length) {
      if (!options.includes(goalYear)) goalYear = options[Math.floor((options.length - 1) / 2)];
      $('years').innerHTML = options.map((y) => `<button type="button" data-year="${y}" aria-pressed="${y === goalYear}">${y}</button>`).join('');
      const by = (goalYear - nowYear) * 12 + (11 - start.getMonth()); // months until December of that year
      let lo = pay, hi = Math.max(pay * 40, 20000);
      if (!plan(hi) || plan(hi).i > by) { $('need').textContent = `Not reachable from these numbers. Try a later year.`; }
      else {
        for (let k = 0; k < 40; k++) { const mid = (lo + hi) / 2, m = plan(mid); if (m && m.i <= by) hi = mid; else lo = mid; }
        const needPay = Math.ceil(hi / 5) * 5;
        $('need').innerHTML = `To be sunny by the end of ${goalYear}: about <b>${gbp(needPay)} a month</b>, ${gbp(needPay - pay)} more than now. Calm Money helps you find it.`;
      }
    }
    drawSky();
    fitHeadline();
  };

  // Keep the headline on one line on wider screens: shrink it just enough when the words are long
  const fitHeadline = () => {
    const h = $('headline'); h.style.fontSize = '';
    if (matchMedia('(max-width: 720px)').matches) return;
    const room = h.parentElement.clientWidth, need = h.scrollWidth;
    if (need > room) h.style.fontSize = (parseFloat(getComputedStyle(h).fontSize) * room / need * 0.98) + 'px';
  };
  new ResizeObserver(fitHeadline).observe($('sky'));
  document.fonts.ready.then(fitHeadline);

  document.addEventListener('click', (e) => {
    const d = e.target.closest('.day'); if (d) { stop(); t.value = d.dataset.n; drawSky(); }
    const y = e.target.closest('[data-year]'); if (y) { goalYear = Number(y.dataset.year); render(); }
  });
  // Typing a number re-runs the forecast and nudges the headline, so the link between the two is visible
  let flashT = 0;
  const changed = () => { render(); const h = $('headline'); h.classList.remove('flash'); void h.offsetWidth; h.classList.add('flash'); clearTimeout(flashT); flashT = setTimeout(() => h.classList.remove('flash'), 700); };
  // Each box grows and shrinks with what's typed, so longer numbers like 12.9 never get cut off
  const ruler = document.createElement('span');
  Object.assign(ruler.style, { position: 'absolute', visibility: 'hidden', whiteSpace: 'pre', left: '-9999px', top: '0' });
  document.body.appendChild(ruler);
  const fit = (i) => {
    const cs = getComputedStyle(i);
    Object.assign(ruler.style, { fontFamily: cs.fontFamily, fontSize: cs.fontSize, fontWeight: cs.fontWeight, fontVariantNumeric: cs.fontVariantNumeric, letterSpacing: cs.letterSpacing });
    ruler.textContent = i.value || '0';
    i.style.width = Math.ceil(ruler.getBoundingClientRect().width) + 3 + 'px';
  };
  document.fonts.ready.then(() => document.querySelectorAll('.in input').forEach(fit));
  document.querySelectorAll('.in input').forEach((i) => {
    fit(i);
    i.addEventListener('input', () => fit(i));
    i.addEventListener('input', changed);
    i.addEventListener('blur', () => { i.value = num(i.id).toLocaleString('en-GB', { maximumFractionDigits: 2 }); fit(i); render(); });
  });
  t.addEventListener('input', () => { stop(); drawSky(); });

  // Play the forecast: the slider runs from today to sunny, once when it comes into view and again on request
  let raf = 0;
  const stop = () => { cancelAnimationFrame(raf); raf = 0; };
  const play = () => {
    if (!P) return; stop();
    const total = P.i, t0 = performance.now(), dur = 3200;
    const step = (now) => { const k = Math.min(1, (now - t0) / dur); t.value = Math.round(total * (1 - Math.pow(1 - k, 2))); drawSky(); if (k < 1) raf = requestAnimationFrame(step); else raf = 0; };
    raf = requestAnimationFrame(step);
  };
  $('play').addEventListener('click', play);
  const reduce = matchMedia('(prefers-reduced-motion: reduce)').matches;
  if (!reduce && 'IntersectionObserver' in window) {
    const io = new IntersectionObserver((es) => { if (es.some((e) => e.isIntersecting)) { io.disconnect(); setTimeout(play, 400); } }, { threshold: 0.5 });
    io.observe($('sky'));
  }
  render();

  // ---- Site wiring: email sign-up (Klaviyo), stats, the system section and the bridge text ----
  const root = $('calculator');
  const firstStep = {
    debt: () => 'Write down every debt with its balance, interest rate and minimum payment. You can’t plan around a number you haven’t seen.',
    secure: (a) => `Open a separate easy access savings account and set up a standing order of ${a} for the day after payday.`,
    wealth: (a) => `Set your ${a} to move automatically the day after payday, so it’s invested before it can be spent.`,
  };
  // The first milestone ahead, in the shape the Klaviyo result emails already use
  const firstGoal = () => {
    if (!P) return null;
    if (P.owe > 0) return { goal: 'debt', headline: 'You could be debt free by', months: P.d, note: `That's ${span(P.d)} away, with roughly ${gbp(P.interest)} paid in interest.` };
    if (P.s > 0) return { goal: 'secure', headline: `You could have ${FUND_MONTHS} months of breathing space by`, months: P.s, note: `Your target is ${gbp(P.fund)}. That's ${span(P.s)} away.` };
    return { goal: 'wealth', headline: 'You could have your first £10,000 invested by', months: P.i, note: `That's ${span(P.i)} away.` };
  };

  // Lets the system section highlight the module for the stage being shown
  const GOAL = { stormy: 'debt', clearing: 'secure', calm: 'secure', sunny: 'wealth' };
  let lastGoal = '';
  const announce = () => {
    if (!P) return;
    const g = GOAL[stage(P, Number(t.value))];
    if (g === lastGoal) return;
    lastGoal = g; root.dataset.goal = g;
    document.dispatchEvent(new CustomEvent('calm:goal', { detail: { goal: g } }));
  };
  t.addEventListener('input', announce);
  document.addEventListener('click', (e) => { if (e.target.closest('.day')) announce(); });

  // The bridge below the card: the whole journey depends on keeping going
  const bridge = () => {
    const big = root.querySelector('[data-bridge]'), turn = root.querySelector('[data-turn]');
    const stroke = (s) => `<span class="stroke">${s}</span>`;
    if (!P) { big.textContent = 'Right now, there’s no date to aim for.'; turn.innerHTML = `${stroke('A system')} is how you get one.`; return; }
    const m = `${P.i} month${P.i > 1 ? 's' : ''}`;
    big.innerHTML = `${date(P.i, 'long')} depends on putting <b>${gbp(P.pay)}</b> aside <b>every month for&nbsp;${m}</b>, without missing one.`;
    turn.innerHTML = `Willpower won’t carry you for ${m}.<br class="wide-only"> ${stroke('A system will.')}`;
  };

  // Email me my forecast: an event carrying the result (it triggers the email) and a sign-up to the list
  const keep = root.querySelector('.keep'), msg = keep.querySelector('[data-keep-msg]'), sendBtn = keep.querySelector('button');
  const klaviyo = (path, data) =>
    fetch(`https://a.klaviyo.com/client/${path}/?company_id=${encodeURIComponent(root.dataset.key)}`, {
      method: 'POST',
      headers: { 'Content-Type': 'application/vnd.api+json', revision: '2024-10-15' },
      body: JSON.stringify({ data }),
    }).then((res) => { if (!res.ok) throw new Error(String(res.status)); });
  keep.addEventListener('submit', async (e) => {
    e.preventDefault();
    const data = new FormData(keep);
    const email = String(data.get('email') || '').trim();
    if (data.get('company')) return; // a bot
    if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) { msg.textContent = 'Please check your email address.'; return; }
    const { key, list } = root.dataset;
    if (!key || !list) { msg.textContent = 'This isn’t connected yet. Please email hello@peterkomolafe.com.'; return; }
    const f = firstGoal();
    if (!f) { msg.textContent = 'Try a higher monthly amount first, so there’s a forecast to send.'; return; }
    const profile = { data: { type: 'profile', attributes: { email } } };
    sendBtn.disabled = true; sendBtn.textContent = 'Sending…';
    try {
      await Promise.all([
        klaviyo('events', {
          type: 'event',
          attributes: {
            properties: {
              goal: f.goal, headline: f.headline, date: date(f.months, 'long'), note: f.note, months: f.months,
              monthly: gbp(P.pay), first_step: firstStep[f.goal](gbp(P.pay)),
              debt_free: P.owe > 0 ? date(P.d, 'long') : '', safety_net: date(P.s, 'long'), sunny: date(P.i, 'long'),
              forecast_headline: $('headline').textContent, forecast_sub: $('sub').textContent, days: P.days,
            },
            metric: { data: { type: 'metric', attributes: { name: 'Calculated goal' } } },
            profile,
          },
        }),
        klaviyo('subscriptions', {
          type: 'subscription',
          attributes: { custom_source: 'Calm Money website: money forecast', profile },
          relationships: { list: { data: { type: 'list', id: list } } },
        }),
      ]);
      window.calmTrack?.('Result emailed', { goal: f.goal });
      keep.reset();
      msg.textContent = 'Sent. Check your inbox for your forecast.';
    } catch {
      msg.textContent = 'Something went wrong. Please try again.';
    } finally {
      sendBtn.disabled = false; sendBtn.textContent = 'Send it';
    }
  });

  // Counted once per visit, on the first change to the numbers
  let used = false;
  root.querySelector('.inputs').addEventListener('input', () => {
    if (used) return; used = true;
    window.calmTrack?.('Calculator used', { goal: firstGoal()?.goal || 'none' });
  });

  // Re-run the site wiring whenever the forecast re-renders
  const baseRender = render;
  render = () => { baseRender(); bridge(); keep.hidden = !P; lastGoal = ''; announce(); };
  render();
})();
</script>

