---
// The full support waitlist: a pop-up opened by the "Join the waitlist" button, which sends the sign-up
// straight to a Klaviyo list through Klaviyo's public subscribe endpoint. No Klaviyo script, no cookies.
// Set the public key and list ID in src/data/site.json (or Site settings in /admin).
import site from '../data/site.json';
---
<dialog class="waitlist" aria-labelledby="waitlist-title" data-key={site.klaviyo_public_key} data-list={site.klaviyo_waitlist_list_id}>
  <button class="close" type="button" aria-label="Close" data-close></button>

  <div class="step" data-step="form">
    <p class="eyebrow">12 months of full support</p>
    <h2 id="waitlist-title">Join the waitlist</h2>
    <p class="intro">This option runs in intakes with limited places. Leave your details and you’ll hear first when the next intake opens.</p>

    <form novalidate>
      <label>
        <span>First name</span>
        <input name="first_name" type="text" autocomplete="given-name" required />
      </label>
      <label>
        <span>Email</span>
        <input name="email" type="email" autocomplete="email" inputmode="email" required />
      </label>
      <!-- Left empty by people; bots fill it in -->
      <label class="trap" aria-hidden="true">Leave this empty <input name="company" type="text" tabindex="-1" autocomplete="off" /></label>
      <p class="error" role="alert" hidden></p>
      <button class="btn btn--light" type="submit">Join the waitlist</button>
      <p class="consent">We’ll email you when the next intake opens, plus occasional updates from Peter. Unsubscribe any time. <a href="/privacy">Privacy policy</a>.</p>
    </form>
  </div>

  <div class="step" data-step="done" hidden>
    <h2>You’re on the list.</h2>
    <p class="intro">We’ll email you as soon as the next intake opens. If our first email doesn’t arrive, check your spam or promotions folder.</p>
    <button class="btn btn--light" type="button" data-close>Back to the page</button>
  </div>
</dialog>

<script>
  const dialog = document.querySelector<HTMLDialogElement>('dialog.waitlist');
  if (dialog) {
    const form = dialog.querySelector('form')!;
    const error = dialog.querySelector<HTMLElement>('.error')!;
    const submit = form.querySelector<HTMLButtonElement>('button[type="submit"]')!;
    const steps = [...dialog.querySelectorAll<HTMLElement>('[data-step]')];
    const show = (name: string) => steps.forEach((s) => (s.hidden = s.dataset.step !== name));

    // Any link to #waitlist opens the pop-up
    document.addEventListener('click', (e) => {
      const link = (e.target as Element).closest('a[href="#waitlist"]');
      if (!link) return;
      e.preventDefault();
      show('form');
      error.hidden = true;
      dialog.showModal();
    });
    dialog.querySelectorAll('[data-close]').forEach((b) => b.addEventListener('click', () => dialog.close()));
    // A tap on the dimmed backdrop closes it too
    dialog.addEventListener('click', (e) => { if (e.target === dialog) dialog.close(); });

    const fail = (message: string) => { error.textContent = message; error.hidden = false; };

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      error.hidden = true;
      const data = new FormData(form);
      const firstName = String(data.get('first_name') || '').trim();
      const email = String(data.get('email') || '').trim();
      if (data.get('company')) return show('done'); // a bot: pretend it worked
      if (!firstName) return fail('Please add your first name.');
      if (!/^[^\s@]+@[^\s@]+\.[^\s@]+$/.test(email)) return fail('Please check your email address.');

      const { key, list } = dialog.dataset;
      if (!key || !list) return fail('Sign-ups aren’t connected yet. Please email hello@peterkomolafe.com and we’ll add you.');

      submit.disabled = true;
      submit.textContent = 'Adding you…';
      try {
        const res = await fetch(`https://a.klaviyo.com/client/subscriptions/?company_id=${encodeURIComponent(key)}`, {
          method: 'POST',
          headers: { 'Content-Type': 'application/vnd.api+json', revision: '2024-10-15' },
          body: JSON.stringify({
            data: {
              type: 'subscription',
              attributes: {
                custom_source: 'Calm Money website: full support waitlist',
                profile: { data: { type: 'profile', attributes: { email, first_name: firstName } } },
              },
              relationships: { list: { data: { type: 'list', id: list } } },
            },
          }),
        });
        if (!res.ok) throw new Error(String(res.status));
        form.reset();
        show('done');
      } catch {
        fail('Something went wrong. Please try again, or email hello@peterkomolafe.com.');
      } finally {
        submit.disabled = false;
        submit.textContent = 'Join the waitlist';
      }
    });
  }
</script>

<style>
  .waitlist { width: min(460px, calc(100vw - 32px)); max-height: calc(100dvh - 32px); padding: 36px 32px 28px; border: 0; border-radius: 22px;
    /* The deep teal of the full support card it opens from */
    background: linear-gradient(180deg, #3d5453, #34494a 40%); color: var(--cream); box-shadow: var(--lift); overflow: auto; }
  .waitlist::backdrop { background: rgb(31 38 36 / 0.45); }
  .waitlist[open] { animation: rise 0.25s ease-out; }
  @keyframes rise { from { opacity: 0; translate: 0 12px; } }

  /* A blush cross, like the plus signs on the teal card */
  .close { position: absolute; top: 14px; right: 14px; width: 36px; height: 36px; border: 0; border-radius: 50%; background: transparent; cursor: pointer; }
  .close::before, .close::after { content: ''; position: absolute; left: 10px; top: 17px; width: 16px; height: 2px; background: var(--blush); rotate: 45deg; }
  .close::after { rotate: -45deg; }
  .close:hover { background: rgb(245 232 216 / 0.10); }
  .close:focus-visible { outline: 2px solid var(--blush); outline-offset: 2px; }

  .eyebrow { margin: 0 0 8px; font-size: 0.8rem; font-weight: 600; letter-spacing: 0.12em; text-transform: uppercase; color: var(--blush); }
  h2 { margin: 0 0 10px; font-family: var(--font-display); font-weight: 400; font-size: 2rem; line-height: 1.15; color: var(--cream); }
  .intro { margin: 0 0 22px; color: #d6d1c6; line-height: 1.55; }

  form { display: grid; gap: 14px; }
  label { display: grid; gap: 6px; font-weight: 500; font-size: 0.95rem; }
  input { font: inherit; font-weight: 400; padding: 12px 14px; border: 1px solid transparent; border-radius: 10px; background: #fff; color: var(--ink); font-size: 17px; /* 16px or more so iPhones don't zoom */ }
  input:focus { outline: 2px solid var(--blush); outline-offset: 2px; }
  .trap { position: absolute; left: -9999px; width: 1px; height: 1px; overflow: hidden; }
  .error { margin: 0; color: var(--blush); font-weight: 500; }
  .btn { width: 100%; justify-content: center; margin-top: 4px; }
  .btn--light { background: var(--cream); color: var(--ink); }
  .btn--light:hover { background: #fff; color: var(--ink); }
  .btn:disabled { opacity: 0.7; cursor: progress; }
  .consent { margin: 0; font-size: 13px; line-height: 1.5; color: #bbb8ad; }
  .consent a { color: inherit; text-underline-offset: 3px; }

  /* Phones: a sheet that rises from the bottom edge, full width, like a native app */
  @media (max-width: 760px) {
    .waitlist { width: 100%; max-width: none; margin: auto 0 0; max-height: 92dvh; border-radius: 22px 22px 0 0;
      padding: 28px 20px calc(20px + env(safe-area-inset-bottom)); }
    .waitlist[open] { animation: sheet 0.3s ease-out; }
    .waitlist::backdrop { background: rgb(31 38 36 / 0.6); }
    /* A grab handle, so it reads as a sheet */
    .waitlist::before { content: ''; position: absolute; top: 9px; left: 50%; translate: -50% 0; width: 40px; height: 4px; border-radius: 2px; background: rgb(245 232 216 / 0.3); }
    .close { top: 12px; right: 10px; }
    .eyebrow { font-size: 0.72rem; margin-bottom: 6px; }
    h2 { font-size: 26px; margin-bottom: 8px; }
    .intro { font-size: 16px; line-height: 1.5; margin-bottom: 18px; }
    form { gap: 12px; }
    label { font-size: 15px; gap: 5px; }
    input { padding: 11px 14px; }
  }
  @keyframes sheet { from { translate: 0 100%; } }
  @media (prefers-reduced-motion: reduce) { .waitlist[open] { animation: none !important; } }
</style>
