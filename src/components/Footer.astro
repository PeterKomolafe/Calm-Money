---
import Logo from './Logo.astro';
import site from '../data/site.json';
const year = new Date().getFullYear();
---
<footer class="site-footer">
  <div class="inner">
    <div class="top">
      <a class="brand" href="/"><Logo size={24} title="" />{site.name}</a>
      <ul>
        {site.youtube_url && <li><a href={site.youtube_url} rel="noopener">YouTube</a></li>}
        <li><a href="/privacy">Privacy</a></li>
        <li><a href={`mailto:${site.email}`}>Contact</a></li>
      </ul>
    </div>
    <p class="disclaimer">{site.disclaimer}</p>
    <p class="small">&copy; {year} {site.owner}</p>
  </div>
</footer>

<style>
  .site-footer { background: #fff; border-top: 1px solid var(--ink); padding: 40px 0 32px; font-size: 0.95rem; color: var(--muted); }
  .inner { max-width: 1180px; margin: 0 auto; padding: 0 32px; }
  .top { display: flex; justify-content: space-between; align-items: center; gap: 24px; flex-wrap: wrap; margin-bottom: 24px; }
  .brand { display: inline-flex; align-items: center; gap: 10px; text-decoration: none; font-weight: 500; font-size: 1.15rem; color: var(--ink); }
  ul { list-style: none; margin: 0; padding: 0; display: flex; gap: 28px; }
  a { color: var(--ink); }
  .disclaimer { max-width: 80ch; }
  .small { font-size: 0.85rem; margin: 0; }
  @media (max-width: 760px) { .inner { padding: 0 16px; } }
</style>
