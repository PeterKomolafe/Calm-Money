---
import WaitlistPopup from './WaitlistPopup.astro';
// Three ways to join. Price and button sit at the top of each card so they line up
// whatever the length of the list below. The top tier runs in intakes: its button joins the waitlist.
// Replace the first two hrefs with their checkout links; the third opens the waitlist pop-up.
const tiers = [
  {
    name: 'At your pace',
    for: 'For self-starters who want the full system to work through on their own.',
    price: '£297',
    intro: 'What’s included',
    groups: [
      { title: '5 modules, 64 lessons, 2.5 hours', oneLine: true, items: ['From Reset to Investing, at your own pace'] },
      { title: 'Money personality test', items: ['Find out your money personality, with practical tips based on it'] },
      { title: 'Practical tools', items: ['Exercises and guides to put every module into action'] },
      { title: 'Lifetime access', items: ['The content library is yours to come back to, for good'] },
    ],
    cta: 'Start at your pace',
    href: '#pricing',
  },
  {
    name: 'At your pace with coaching',
    for: 'For people who want a check-in every quarter to stay on track.',
    recommended: true,
    price: '£1,297',
    intro: 'Everything in At your pace, plus',
    groups: [
      { title: '4 quarterly coaching sessions', items: ['One every three months, across 12\u00a0months'] },
      { title: 'Review & accountability', items: ['Track your progress against the timeline you set and stay accountable to the goals that matter'] },
      { title: 'Adjust your plan', items: ['Life changes. Your income shifts. Your goals evolve. Get expert guidance to keep your system up to date'] },
      { title: 'Set your next three months', items: ['Leave each session knowing exactly what to focus on until the next one'] },
    ],
    cta: 'Join with coaching',
    href: '#pricing',
  },
  {
    name: '12 months of full support',
    for: 'For people who want Peter in their corner all year.',
    price: '£2,497',
    intro: 'Everything in At your pace, plus',
    groups: [
      { title: 'Onboarding call', items: ['Start with a one-to-one with Peter. Set your goals, get a professional review of your practical exercises, and map out a timeline for action so you know exactly where you are and what comes next'] },
      { title: '24 live online coaching calls', items: ['Every two weeks', 'Q&As, workshops and professional guests', 'Module amplification sessions'] },
      { title: 'Peter on WhatsApp', items: ['Message Peter directly with your questions and get support when you need it', 'Plus updates on new material and news from the community'] },
      { title: '2 meetups a year', items: ['Two in-person meet-ups during your 12 months. A chance to step away from the screen, meet the people on the same journey as you, and take stock of how far you’ve come'] },
    ],
    cta: 'Join the waitlist',
    href: '#waitlist', // opens the waitlist pop-up
    apply: true,
  },
];
---
<section class="pricing" id="pricing">
  <h2>Choose how you’re supported.</h2>
  <p class="lede">Every option includes the full five-module programme, with lifetime access to the content library.</p>

  <div class="tiers">
    {tiers.map((t) => (
      <article class:list={['tier', { full: t.apply }]}>
        {t.recommended && <span class="badge">Recommended</span>}
        <h3>{t.name}</h3>
        <p class="for">{t.for}</p>
        <p class="price">{t.price}</p>
        <a class:list={['btn', t.apply ? 'btn--light' : 'btn--primary']} href={t.href}>{t.cta}</a>
        {t.apply && <p class="next">Runs in intakes with limited places. Join the waitlist to hear first when the next intake opens.</p>}

        <!-- Phones: the list opens with "See what's included". Wider screens: always open -->
        <details class="inc" open>
          <summary>See what’s included</summary>
          <p class="intro">{t.intro}</p>
          <ul>
            {t.groups.map((g) => (
              <li>
                <strong class:list={{ "one-line": g.oneLine }}>{g.title}</strong>
                <span>{g.items.join('. ')}.</span>
              </li>
            ))}
          </ul>
        </details>
      </article>
    ))}
  </div>
  <WaitlistPopup />
  <p class="guarantee">Both coaching options come with a 30-day money-back guarantee. <a href="#guarantee">See how it works</a>.</p>
</section>

<script>
  // Phones start with each list closed; wider screens keep them open
  const lists = [...document.querySelectorAll<HTMLDetailsElement>('#pricing details.inc')];
  const phone = matchMedia('(max-width: 760px)');
  const fit = () => lists.forEach((d) => { d.open = !phone.matches; });
  fit();
  phone.addEventListener('change', fit);
</script>

<style>
  .pricing { max-width: 1160px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  h2 { font-family: var(--font-body); font-weight: 450; letter-spacing: -0.02em; font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 14px; }
  .lede { font-size: 1.25rem; color: var(--muted); margin: 0 0 44px; }

  .tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: start; }
  .tier { display: flex; flex-direction: column; background: var(--cream); border-radius: 22px; padding: clamp(24px, 2.6vw, 32px); box-shadow: var(--lift); container-type: inline-size; position: relative; }

  h3 { margin: 0; font-family: var(--font-body); font-weight: 500; font-size: 1.1rem; color: var(--ink); }
  /* Sits on the card's top edge so it takes no room: prices and buttons stay level across the three cards */
  .badge { position: absolute; top: 0; left: clamp(24px, 2.6vw, 32px); translate: 0 -50%; padding: 4px 12px; border-radius: 999px; background: var(--terracotta-dark); color: #fff; font-size: 0.8rem; font-weight: 500; letter-spacing: 0.02em; }
  .for { margin: 6px 0 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }
  .next { margin: 14px 0 0; font-size: 0.9rem; line-height: 1.5; color: #bbb8ad; }
  .guarantee { margin: 28px 0 0; text-align: center; color: var(--muted); font-size: 1.05rem; }
  .guarantee a { color: var(--terracotta-dark); text-underline-offset: 4px; }
  .price { margin: 14px 0 22px; font-family: var(--font-body); font-weight: 450; letter-spacing: -0.03em; font-size: clamp(2.6rem, 4vw, 3.4rem); line-height: 1; color: var(--teal-dark); }
  .btn { align-self: flex-start; padding-inline: 1.4em; }

  .intro { margin: 26px 0 12px; padding-top: 20px; border-top: 1px solid rgb(31 38 36 / 0.12); font-size: 0.95rem; font-weight: 600; color: var(--muted); }
  /* The list scales with the card so its widest title always spans the full width */
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; font-size: min(1.125rem, 6.25cqi); }
  li { display: grid; gap: 2px; padding-left: 22px; position: relative; line-height: 1.4; }
  li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 9px; height: 9px; border-radius: 50%; background: var(--teal); }
  strong { font-weight: 500; color: var(--ink); }
  .one-line { white-space: nowrap; }
  li span { font-size: 0.95em; color: var(--muted); }

  /* The most supported option uses the calculator's deep-teal card */
  .full { background: linear-gradient(180deg, #3d5453, #34494a 40%); color: #f5e8d8; }
  .full h3, .full .price, .full strong { color: #f5e8d8; }
  .full .intro, .full li span, .full .for { color: #bbb8ad; }
  .full .intro { border-top-color: rgb(245 232 216 / 0.18); }
  .full li::before { background: var(--blush); }
  .btn--light { background: var(--cream); color: var(--ink); }
  .btn--light:hover { background: #fff; color: var(--ink); }

  .inc summary { display: none; }

  @media (max-width: 1000px) {
    .tiers { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; row-gap: 40px; } /* room for the Recommended badge between stacked cards */
  }
  @media (max-width: 760px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; margin-bottom: 20px; }
    .lede { font-size: 18px; line-height: 1.55; }
    li strong { font-size: min(19px, 6.25cqi); } /* the one-line lesson count still fits on the smallest phones */
    .pricing { padding-inline: 24px; }
    .tier { padding: 28px; }

    .inc { margin-top: 18px; border-top: 1px solid rgb(31 38 36 / 0.12); }
    .full .inc { border-top-color: rgb(245 232 216 / 0.18); }
    .inc summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 16px 0 4px; font-weight: 500; }
    .inc summary::-webkit-details-marker { display: none; }
    .inc summary::after { content: ''; width: 14px; height: 14px; background:
        linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
        linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; }
    .inc[open] summary::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
    .full .inc summary::after { background:
        linear-gradient(var(--blush), var(--blush)) center / 100% 2px no-repeat,
        linear-gradient(var(--blush), var(--blush)) center / 2px 100% no-repeat; }
    .full .inc[open] summary::after { background: linear-gradient(var(--blush), var(--blush)) center / 100% 2px no-repeat; }
    .inc summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
    .inc .intro { border-top: 0; padding-top: 8px; margin-top: 0; }
  }
</style>
