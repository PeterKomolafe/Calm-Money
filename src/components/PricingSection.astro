---
import WaitlistPopup from './WaitlistPopup.astro';
// Three ways to join. Price and button sit at the top of each card so they line up
// whatever the length of the list below. The top tier runs in intakes: its button joins the waitlist.
// The first two buttons start checkout (netlify/functions); the third opens the waitlist pop-up.
const tiers = [
  {
    name: 'At your pace',
    for: 'For self-starters who want the full system to work through on their own.',
    price: '£397',
    intro: 'What’s included',
    groups: [
      { title: '5 modules, 64 lessons, 2.5 hours', oneLine: true, items: ['From Reset to Investing, at your own pace'] },
      { title: 'Money personality test', items: ['Find out your money personality, with practical tips based on it'] },
      { title: 'Practical tools', items: ['Exercises and guides to put every module into action'] },
      { title: 'The Calm Money community', items: ['Share wins, swap tips and stay motivated with other members'] },
      { title: 'A monthly update from Peter', items: ['A short recorded update on what’s changed in UK money and what it means for your system'] },
      { title: 'Workshop library', items: ['Replays of Peter’s workshops, such as how to tell if you’re investing enough'] },
      { title: '12 months’ access', items: ['The content library and its tools are yours to come back to'] },
    ],
    cta: 'Start at your pace',
    href: '/pay/at-your-pace', // Stripe Checkout (netlify/functions/at-your-pace.mjs)
  },
  {
    name: 'At your pace with coaching',
    for: 'For people who want a check-in every quarter to stay on track.',
    recommended: true,
    plan: true, // pay in full or in three payments, chosen on /join/coaching/
    price: '£1,297',
    intro: 'Everything in At your pace, plus',
    groups: [
      { title: 'Onboarding call', items: ['Start with a one-to-one with Peter to set your goals and map out your timeline'] },
      { title: '4 quarterly coaching sessions', items: ['One every three months, across 12\u00a0months'] },
      { title: 'Review & accountability', items: ['Track your progress against the timeline you set and stay accountable to the goals that matter'] },
      { title: 'Adjust your plan', items: ['Life changes. Your income shifts. Your goals evolve. Get expert guidance to keep your system up to date'] },
      { title: 'Set your next three months', items: ['Leave each session knowing exactly what to focus on until the next one'] },
    ],
    cta: 'Join with coaching',
    href: '/join/coaching/',
  },
  {
    name: '12 months of full support',
    for: 'For people who want Peter in their corner all year.',
    price: '£2,997',
    intro: 'Everything in At your pace with coaching, plus',
    groups: [
      { title: 'Onboarding review', items: ['Start with a one-to-one with Peter. Set your goals, get a professional review of your practical exercises, and map out a timeline for action'] },
      { title: '12 monthly live group calls', items: ['One a month', 'Q&As, workshops and professional guests', 'Module amplification sessions'] },
      { title: 'Peter on WhatsApp', items: ['Message Peter directly with your questions and get support when you need it'] },
      { title: '2 meetups a year', items: ['Two in-person meet-ups during your 12 months. A chance to step away from the screen, meet the people on the same journey as you, and take stock of how far you’ve come'] },
    ],
    cta: 'Join the waitlist',
    href: '#waitlist', // opens the waitlist pop-up
    apply: true,
  },
];

// Side-by-side comparison under the cards: true = included, false = not. Quantities live in the labels
const compare: [string, ...(boolean | string)[]][] = [
  ['Five modules, 64 lessons', true, true, true],
  ['Money personality test', true, true, true],
  ['Practical tools and guides', true, true, true],
  ['The Calm Money community', true, true, true],
  ['Monthly update from Peter', true, true, true],
  ['Workshop library', true, true, true],
  ['Onboarding call with Peter', false, true, true],
  ['Review of your practical exercises', false, false, true],
  ['4 quarterly coaching sessions', false, true, true],
  ['12 monthly live group calls', false, false, true],
  ['Peter on WhatsApp', false, false, true],
  ['2 in-person meet-ups', false, false, true],
  ['30-day money-back guarantee', false, true, true],
  ['12 months’ access', true, true, true],
];
---
<section class="pricing" id="pricing">
  <h2>Choose how you’re supported.</h2>
  <p class="lede">Every option includes the full five-module programme, the community and Peter’s monthly update, with 12 months’ access.</p>

  <div class="tiers">
    {tiers.map((t) => (
      <article class:list={['tier', { full: t.apply }]}>
        {t.recommended && <span class="badge">Recommended</span>}
        <h3>{t.name}</h3>
        <p class="for">{t.for}</p>
        <p class="price">{t.price}</p>
        <a class:list={['btn', t.apply ? 'btn--light' : 'btn--primary']} href={t.href}>{t.cta}</a>
        {t.plan && <p class="next">Pay in one go, or £697 today then 2 monthly payments of £300. No interest, no extra charge.</p>}
        {t.apply && <p class="next">10 places per intake, with instalments available. Join the waitlist to hear first when the next one opens.</p>}

        <!-- Phones: the list opens with "See what's included". Wider screens: always open -->
        <details class="inc" open>
          <summary>See what’s included</summary>
          <p class="intro">{t.intro}</p>
          <ul>
            {t.groups.map((g) => (
              <li>
                <strong class:list={{ "one-line": g.oneLine }}>{g.title}</strong>
                <span>{g.items.join('. ')}.</span>
              </li>
            ))}
          </ul>
        </details>
      </article>
    ))}
  </div>
  <details class="compare">
    <summary class="compare-title">Compare the options</summary>
    <div class="table-wrap">
      <table>
        <colgroup><col class="feat" /><col /><col /><col /></colgroup>
        <thead>
          <tr>
            <td></td>
            {tiers.map((t) => <th scope="col" class:list={{ rec: t.recommended }}>{t.name.replace('At your pace with coaching', 'With coaching').replace('12 months of full support', 'Full support')}<span>{t.price}</span></th>)}
          </tr>
        </thead>
        <tbody>
          {compare.map(([label, ...cells]) => (
            <tr>
              <th scope="row">{label}</th>
              {cells.map((c, i) => (
                <td class:list={{ rec: tiers[i].recommended }}>
                  {c === true ? <span class="yes" role="img" aria-label="Included">✓</span>
                    : c === false ? <span class="no" role="img" aria-label="Not included">–</span>
                    : <span class="val">{c}</span>}
                </td>
              ))}
            </tr>
          ))}
        </tbody>
      </table>
    </div>
  </details>

  <WaitlistPopup />
  <p class="guarantee">Both coaching options come with a 30-day money-back guarantee. <a href="#guarantee">See how it works</a>.</p>
</section>

<script>
  // Phones start with each list closed; wider screens keep them open
  const lists = [...document.querySelectorAll<HTMLDetailsElement>('#pricing details.inc')];
  const phone = matchMedia('(max-width: 760px)');
  const fit = () => lists.forEach((d) => { d.open = !phone.matches; });
  fit();
  phone.addEventListener('change', fit);
</script>

<style>
  .pricing { max-width: 1160px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  h2 { font-family: var(--font-body); font-weight: var(--w-bold); letter-spacing: var(--track-display); font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 var(--space-title); }
  .lede { font-size: 1.25rem; color: var(--muted); margin: 0 0 var(--space-content); }

  .tiers { display: grid; grid-template-columns: repeat(3, minmax(0, 1fr)); gap: 24px; align-items: stretch; } /* equal-height cards side by side */
  .tier { display: flex; flex-direction: column; background: var(--cream); border-radius: 22px; padding: clamp(24px, 2.6vw, 32px); box-shadow: var(--lift); container-type: inline-size; position: relative; }

  h3 { margin: 0; font-family: var(--font-body); font-weight: var(--w-medium); font-size: 1.1rem; color: var(--ink); }
  /* Sits on the card's top edge so it takes no room: prices and buttons stay level across the three cards */
  .badge { position: absolute; top: 0; left: clamp(24px, 2.6vw, 32px); translate: 0 -50%; padding: 4px 12px; border-radius: 999px; background: var(--terracotta-dark); color: #fff; font-size: 0.8rem; font-weight: var(--w-medium);  }
  .for { margin: 6px 0 0; color: var(--muted); font-size: 0.95rem; line-height: 1.45; }
  .next { margin: 14px 0 0; font-size: 0.9rem; line-height: 1.5; color: var(--muted); }
  .guarantee { margin: 28px 0 0; text-align: center; color: var(--muted); font-size: 1.05rem; }
  .guarantee a { color: var(--terracotta-dark); text-underline-offset: 4px; }
  .price { margin: 14px 0 22px; font-family: var(--font-body); font-weight: var(--w-bold); letter-spacing: var(--track-display); font-size: clamp(2.6rem, 4vw, 3.4rem); line-height: 1; color: var(--teal-dark); }
  .btn { align-self: flex-start; padding-inline: 1.4em; }

  .intro { margin: 26px 0 12px; padding-top: 20px; border-top: 1px solid rgb(31 38 36 / 0.12); font-size: 0.95rem; font-weight: var(--w-medium); color: var(--muted); }
  /* The list scales with the card so its widest title always spans the full width */
  ul { list-style: none; margin: 0; padding: 0; display: grid; gap: 14px; font-size: min(1.125rem, 6.25cqi); }
  li { display: grid; gap: 2px; padding-left: 22px; position: relative; line-height: 1.4; }
  li::before { content: ''; position: absolute; left: 0; top: 0.5em; width: 9px; height: 9px; border-radius: 50%; background: var(--teal); }
  strong { font-weight: var(--w-medium); color: var(--ink); }
  .one-line { white-space: nowrap; }
  li span { font-size: 0.95em; color: var(--muted); }

  /* The most supported option uses the calculator's deep-teal card */
  .full { background: linear-gradient(180deg, #3d5453, #34494a 40%); color: #f5e8d8; }
  .full h3, .full .price, .full strong { color: #f5e8d8; }
  .full .intro, .full li span, .full .for, .full .next { color: #bbb8ad; }
  .full .intro { border-top-color: rgb(245 232 216 / 0.18); }
  .full li::before { background: var(--blush); }
  .btn--light { background: var(--cream); color: var(--ink); }
  .btn--light:hover { background: #fff; color: var(--ink); }

  .inc summary { display: none; }

  /* Comparison table: the recommended column is tinted so it reads as the default choice */
  .compare { max-width: 880px; margin: clamp(56px, 6vw, 80px) auto 0; }
  /* Closed by default: a centred title with the same plus/minus as the other accordions */
  .compare-title { list-style: none; cursor: pointer; display: flex; justify-content: center; align-items: center; gap: 14px; width: fit-content; margin: 0 auto; padding: 8px 4px;
    font-weight: var(--w-bold); letter-spacing: var(--track-heading); font-size: clamp(1.5rem, 2.4vw, 1.9rem); color: var(--ink); }
  .compare-title::-webkit-details-marker { display: none; }
  .compare-title::after { content: ''; flex: none; width: 14px; height: 14px; background:
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; }
  .compare[open] .compare-title::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
  .compare-title:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; border-radius: 6px; }
  .compare[open] .table-wrap { margin-top: 20px; }
  table { width: 100%; border-collapse: collapse; table-layout: fixed; font-size: 1rem; }
  thead th { padding: 14px 8px; font-weight: var(--w-medium); font-size: 0.95rem; color: var(--ink); text-align: center; vertical-align: bottom; line-height: 1.3; }
  thead th span { display: block; margin-top: 4px; font-weight: var(--w-bold); font-size: 1.2rem; color: var(--teal-dark); letter-spacing: var(--track-heading); }
  tbody th { padding: 13px 12px 13px 0; text-align: left; font-weight: var(--w-regular); color: var(--ink); line-height: 1.35; }
  tbody td { padding: 13px 8px; text-align: center; }
  tbody tr { border-top: 1px solid var(--line); }
  td.rec, th.rec { background: var(--cream); }
  thead th.rec { border-radius: 14px 14px 0 0; }
  tbody tr:last-child td.rec { border-radius: 0 0 14px 14px; }
  col.feat { width: 40%; }
  .yes { color: var(--teal); font-weight: var(--w-bold); font-size: 1.4rem; line-height: 1; }
  .no { color: #a3aaa8; }
  .val { font-weight: var(--w-medium); color: var(--ink); font-size: 1.05rem; }

  @media (max-width: 1000px) {
    .tiers { grid-template-columns: 1fr; max-width: 520px; margin: 0 auto; row-gap: 40px; } /* room for the Recommended badge between stacked cards */
  }
  @media (max-width: 760px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; }
    .lede { font-size: 18px; line-height: 1.55; }
    li strong { font-size: min(19px, 6.25cqi); } /* the one-line lesson count still fits on the smallest phones */
    .pricing { padding-inline: 24px; }
    .tier { padding: 28px; }

    .inc { margin-top: 18px; border-top: 1px solid rgb(31 38 36 / 0.12); }
    .full .inc { border-top-color: rgb(245 232 216 / 0.18); }
    .inc summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; padding: 16px 0 4px; font-weight: var(--w-medium); }
    .inc summary::-webkit-details-marker { display: none; }
    .inc summary::after { content: ''; width: 14px; height: 14px; background:
        linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
        linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; }
    .inc[open] summary::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
    .full .inc summary::after { background:
        linear-gradient(var(--blush), var(--blush)) center / 100% 2px no-repeat,
        linear-gradient(var(--blush), var(--blush)) center / 2px 100% no-repeat; }
    .full .inc[open] summary::after { background: linear-gradient(var(--blush), var(--blush)) center / 100% 2px no-repeat; }
    .inc summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
    .inc .intro { border-top: 0; padding-top: 8px; margin-top: 0; }

    .compare-title { font-size: 23px; }
    table { font-size: 15px; }
    col.feat { width: 44%; }
    thead th { padding: 12px 2px; font-size: 12.5px; }
    thead th span { font-size: min(16px, 4vw); }
    tbody th { padding: 12px 8px 12px 0; }
    tbody td { padding: 12px 4px; }
    .val { font-size: 15px; }
  }
</style>
