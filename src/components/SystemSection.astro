---
// The five modules drawn as the logo ring. The module that builds the visitor's
// chosen goal is lifted out of the ring; every segment keeps its exact logo colour.

const c = 50, r = 34.6, w = 13;
const pt = (deg: number, rad = r) => {
  const a = (deg * Math.PI) / 180;
  return [c + rad * Math.cos(a), c + rad * Math.sin(a)];
};
const arc = (from: number, to: number, dx = 0, dy = 0) => {
  const [x1, y1] = pt(from);
  const [x2, y2] = pt(to);
  return `M ${x1 + dx} ${y1 + dy} A ${r} ${r} 0 ${to - from > 180 ? 1 : 0} 1 ${x2 + dx} ${y2 + dy}`;
};

// Same geometry as the logo. Each module owns one segment and the round cap at its start;
// `prev` is the module whose end meets that start (it needs its own cap when this one lifts).
const modules = [
  { n: 1, title: 'Reset', outcome: 'We begin at ground zero, uncovering what matters most to you, what drives you, and how to use the way you’re wired as a superpower to propel you forward.', from: 231, to: 288, color: 'var(--cream)', prev: 2 },
  { n: 2, title: 'Giving Your Money Structure', outcome: 'Get the structure that brings control and confidence to your day-to-day finances, and becomes the foundation of your system.', from: 171, to: 231, color: 'var(--terracotta)', prev: 3 },
  { n: 3, title: 'Breaking the Debt Cycle', outcome: 'You’ll have an order to pay things off and a date to be debt free.', from: 119, to: 171, color: 'var(--blush)', prev: 4 },
  { n: 4, title: 'Creating Financial Stability', outcome: 'Peace of mind becomes real here. Your financial buffer gives you the freedom to enjoy today and the security to build for tomorrow.', from: 72, to: 119, color: 'var(--sage)', prev: 5 },
  { n: 5, title: 'From Stability to Investing', outcome: 'Learn what you need to know about investing, how to do it safely, avoid the mistakes that cost people most and stay consistent for the long term.', from: -72, to: 72, color: 'var(--teal)', prev: 1 },
];
const byN = Object.fromEntries(modules.map((m) => [m.n, m]));
const lift = (m: (typeof modules)[number]) => {
  const a = (((m.from + m.to) / 2) * Math.PI) / 180;
  return [5.5 * Math.cos(a), 5.5 * Math.sin(a)];
};

// Which module builds each calculator goal
const goalModule = { debt: 3, secure: 4, wealth: 5 };

// Visibility rules for the lifted state, one set per module
const css = modules
  .map((m) => `.system[data-module="${m.n}"] .base-${m.n}{display:none}
.system[data-module="${m.n}"] .lift-${m.n},.system[data-module="${m.n}"] .endcap-${m.n}{display:inline}
.system[data-module="${m.n}"] li[data-m="${m.n}"] .yours{display:inline-block}
.system[data-module="${m.n}"] .num-${m.n}{fill:var(--ink);font-size:6px}`)
  .join('\n');
---
<section class="system" id="programme" data-module="3" data-goal-map={JSON.stringify(goalModule)}>
  <style is:inline set:html={css}></style>
  <h2>Five modules.<br />One complete system.</h2>
  <p class="lede">Calm Money builds the system that turns your income into wealth, one module at a time.</p>

  <div class="grid">
    <svg class="ring" viewBox="-8 -8 116 116" aria-hidden="true">
      <defs>
        <filter id="lift-shadow" filterUnits="userSpaceOnUse" x="-10" y="-10" width="120" height="120">
          <feDropShadow dx="0" dy="1.6" stdDeviation="1.6" flood-color="#1f2624" flood-opacity="0.28" />
        </filter>
      </defs>
      {modules.map((m) => <path class={`base-${m.n}`} d={arc(m.from, m.to)} fill="none" stroke={m.color} stroke-width={w} />)}
      {modules.map((m) => { const [x, y] = pt(m.from); return <circle class={`base-${m.n}`} cx={x} cy={y} r={w / 2} fill={m.color} />; })}
      {modules.map((m) => { const p = byN[m.prev]; const [x, y] = pt(m.from); return <circle class={`endcap endcap-${m.n}`} cx={x} cy={y} r={w / 2} fill={p.color} />; })}
      {modules.map((m) => { const [dx, dy] = lift(m); return <path class={`lifted lift-${m.n}`} d={arc(m.from, m.to, dx, dy)} fill="none" stroke={m.color} stroke-width={w} stroke-linecap="round" filter="url(#lift-shadow)" />; })}
      {modules.map((m) => { const [x, y] = pt((m.from + m.to) / 2, 52); /* clear of a lifted segment's outer edge (46.6) */ return <text class={`num num-${m.n}`} x={x} y={y}>{m.n - 1}</text>; })}
    </svg>

    <ol>
      {modules.slice().sort((a, b) => a.n - b.n).map((m) => (
        <li data-m={m.n} style={`--c:${m.color}`}>
          <details name="modules">
            <summary>
              <span class="n">{String(m.n - 1).padStart(2, '0')}</span>
              <h3>{m.title}</h3>
            </summary>
            <p class="outcome">{m.outcome}</p>
          </details>
          <p class="yours" data-yours></p>
        </li>
      ))}
    </ol>
  </div>
</section>

<script>
  const section = document.querySelector<HTMLElement>('.system')!;
  const map: Record<string, number> = JSON.parse(section.dataset.goalMap!);
  const yours: Record<string, string> = {
    debt: 'Where your debt-free date gets built',
    secure: 'Where your breathing space gets built',
    wealth: 'Where your first £10,000 invested gets built',
  };
  const modules = [...section.querySelectorAll<HTMLDetailsElement>('li details')];
  // One module open at a time (the name attribute does this in current browsers; this covers older ones)
  modules.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) modules.forEach((o) => { if (o !== d) o.open = false; });
  }));
  const show = (goal: string) => {
    section.dataset.module = String(map[goal]);
    section.querySelectorAll<HTMLElement>('[data-yours]').forEach((el) => (el.textContent = yours[goal]));
    // The module that builds the visitor's goal opens with the highlight
    const d = section.querySelector<HTMLDetailsElement>(`li[data-m="${map[goal]}"] details`);
    if (d) d.open = true;
  };
  document.addEventListener('calm:goal', (e) => show((e as CustomEvent<{ goal: string }>).detail.goal));
  // The calculator may have announced its first goal before this script ran
  show(document.querySelector<HTMLElement>('#calculator')?.dataset.goal ?? 'debt');
</script>

<style>
  .system { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  h2 { font-family: var(--font-body); font-weight: 450; letter-spacing: -0.02em; font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 14px; }
  .lede { font-size: 1.25rem; color: var(--muted); margin: 0 0 56px; text-wrap: balance; }

  .grid { display: grid; grid-template-columns: minmax(0, 360px) 1fr; gap: 56px; align-items: center; }
  .ring { width: 100%; overflow: visible; }
  .lifted, .endcap { display: none; }
  .num { font: 600 5px var(--font-body); fill: var(--muted); text-anchor: middle; dominant-baseline: central; }

  /* Each module is a row with a bar of its ring colour down the left and a large serif number */
  ol { list-style: none; margin: 0; padding: 0; display: grid; gap: 10px; }
  li { position: relative; padding: 12px 0 12px 20px; }
  /* The bar carries the same faint outline as the dots, so the cream one still shows on the pale page */
  li::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 4px; background: var(--c); box-shadow: inset 0 0 0 1px rgb(31 38 36 / 0.18); }
  /* Each module opens like the common questions: title row with a plus that turns into a minus */
  summary { list-style: none; cursor: pointer; display: grid; grid-template-columns: 40px 1fr 14px; align-items: center; column-gap: 14px; }
  summary::-webkit-details-marker { display: none; }
  summary::after { content: ''; width: 14px; height: 14px; background:
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; }
  details[open] summary::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
  summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; border-radius: 4px; }
  .n { font-family: var(--font-display); font-weight: 400; font-size: 1.65rem; line-height: 1; color: var(--teal-dark); font-variant-numeric: tabular-nums; }
  h3 { margin: 0; font-family: var(--font-body); font-weight: 500; font-size: 1.3rem; color: var(--ink); }
  li p { margin: 0 0 0 54px; color: var(--muted); } /* lines up under the title */
  /* What the module leaves you with */
  li .outcome { color: var(--ink); margin-top: 10px; }
  /* The visitor's goal: a mint tag under the module that builds it */
  li .yours { display: none; margin-top: 12px; padding: 4px 12px; border-radius: 999px; background: var(--mint); font-size: 0.9rem; font-weight: 600; color: var(--teal-dark); }

  @media (max-width: 760px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; margin-bottom: 20px; }
    .lede { font-size: 18px; line-height: 1.55; }
    h3 { font-size: 19px; }
    li .outcome { font-size: 17px; }
    .system { padding-inline: 24px; }
    .grid { grid-template-columns: 1fr; gap: 32px; }
    .ring { max-width: 280px; margin: 0 auto; }
    li { padding: 10px 0 10px 18px; }
    .n { font-size: 26px; }
  }
</style>
