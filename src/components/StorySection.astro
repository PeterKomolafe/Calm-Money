---
// Peter's story in stages, one photo per stage, chosen from a timeline. A line break in `text` starts a new paragraph.
// `when` labels the stage's point on the timeline
const stages = [
  {
    img: 'early-years', pos: '45% 30%', w: 1075, h: 1165,
    alt: 'Peter as a baby, held up by a woman, with a young boy beside them',
    when: 'Childhood',
    title: 'Fostered from three months old',
    text: 'Fostered at three months old, I grew up without money. I still remember how my friends’ dinners always smelled better than ours. I had no idea the scarcity mindset forming in those moments would go on to hurt my finances as an adult. At eight, I was told I was going to Nigeria for a two-week holiday. It lasted ten years.\nI returned from Nigeria in 1998 with £50 in my pocket and, not understanding how money worked, ended up homeless and sleeping on the streets. By 2001 I was in debt, and I stayed there for over a decade.',
    placeholder: false,
  },
  {
    img: 'office', pos: '35% 40%', w: 1199, h: 1200,
    alt: 'Peter at his desk in an office, in a shirt and tie',
    when: '2006',
    title: 'Canary Wharf',
    text: 'In 2006, I found a job as a bank cashier and worked my way through retail and corporate banking before reaching wealth management in Canary Wharf in 2012. For the first time, I was earning good money, yet I still felt stuck. I understood everyday financial products but knew nothing about investing, and the scarcity mindset from my childhood had me overspending and living for the moment.\nThen a manager showed me I was earning enough to buy my first property. That conversation sparked the biggest mindset shift of my life. I set proper goals, stopped spending aimlessly, cleared debt I’d struggled with for over ten years, bought my first home and finally started investing. Not bad for someone who once slept on the streets.',
    placeholder: false,
  },
  {
    img: 'lorraine', pos: '60% 55%', w: 1200, h: 1200,
    alt: 'Peter being interviewed by Lorraine Kelly on Lorraine',
    when: '2020',
    title: 'Conversations I wish someone had with me',
    text: 'In 2020 I started a YouTube channel, which led to my bestselling book with HarperCollins, The Money Basics: How to Become Your Own Financial Hero, in 2023. I’ve appeared on shows including Lorraine, Steph’s Packed Lunch, Secret Spenders: Beat the Price Rises, Family Budget Switch Up and Jeremy Vine, and as a financial expert on BBC News, Sky News, Channel 5 News and the BBC World Service.',
    placeholder: false,
  },
  {
    img: 'downing-street', pos: '30% 50%', mpos: '30% 29%', w: 900, h: 1200, // mpos: on phones the shorter crop keeps the door number and head in view
    alt: 'Peter outside 10 Downing Street',
    when: 'Number 10',
    title: 'Advocating for financial education',
    text: 'I ended up sleeping on the streets because I didn’t understand simple budgeting. It’s why I joined a team campaigning for financial education to be made compulsory in primary schools, taking our case from Parliament all the way to Number 10. From September 2028, children in England as young as five will learn the fundamentals of money in school.',
    placeholder: false,
  },
  {
    img: 'stage', pos: '36% 40%', w: 1400, h: 933,
    alt: 'Peter speaking on stage at an awards event',
    when: 'Today',
    title: 'Why Calm Money exists',
    text: 'I’ve come a long way from noticing whose dinner smelled better. But the biggest lesson from that journey is one no textbook taught me: you can understand money and still be controlled by it. One conversation shifted my mindset, but it was the action I took afterwards that changed my life. It took years to realise how many people are stuck where I was, earning, trying, and still not moving forward. Calm Money is my answer to that. A place to stop overthinking your money and start taking the steps that move you forward, so you don’t have to wait as long as I did.',
    placeholder: false,
  },
];
// Each stage's marker takes the next ring colour, in the logo's order
const colours = ['var(--cream-bar)', 'var(--terracotta)', 'var(--blush)', 'var(--sage)', 'var(--teal)'];
---
<section class="story" id="story">
  <h2>Why I built Calm Money.</h2>
  <p class="lede">A programme by Peter Komolafe. This is how it came to be.</p>

  <!-- A timeline of the five stages. Each point fills with its colour once visited -->
  <div class="timeline" role="tablist" aria-label="Peter’s story">
    {stages.map((s, i) => (
      <button class:list={['point', { seen: i === 0 }]} role="tab" id={`story-tab-${i}`} aria-controls={`story-panel-${i}`} aria-selected={i === 0 ? 'true' : 'false'} tabindex={i === 0 ? 0 : -1} style={`--dot: ${colours[i]}`} data-tab={i}>
        <span class="node" aria-hidden="true"></span>
        <span class="when">{s.when}</span>
      </button>
    ))}
  </div>

  <!-- Every stage stays in the page for search engines and screen readers; only the chosen one shows -->
  <div class="panels">
    {stages.map((s, i) => (
      <article class:list={['panel', { on: i === 0, placeholder: s.placeholder }]} role="tabpanel" id={`story-panel-${i}`} aria-labelledby={`story-tab-${i}`} data-panel={i} style={`--dot: ${colours[i]}`}>
        <div class="text">
          <h3><span class="step">{i + 1}.</span> {s.title}</h3>
          {s.text.split('\n').map((para) => <p>{para}</p>)}
          {s.placeholder && <span class="tag">Placeholder</span>}
        </div>
        <figure class="photo">
          <img src={`/images/story/${s.img}.webp`} width={s.w} height={s.h} alt={s.alt} loading={i === 0 ? 'eager' : 'lazy'} decoding="async" style={`object-position: ${s.pos}${'mpos' in s ? `; --mpos: ${s.mpos}` : ''}`} />
        </figure>
      </article>
    ))}
  </div>
</section>

<script>
  const story = document.querySelector<HTMLElement>('#story'); // by id: member-story cards also use .story
  if (story) {
    const tabs = [...story.querySelectorAll<HTMLButtonElement>('[data-tab]')];
    const panels = [...story.querySelectorAll<HTMLElement>('[data-panel]')];
    const show = (i: number, focus = false) => {
      tabs.forEach((t, j) => {
        const on = j === i;
        t.setAttribute('aria-selected', String(on));
        t.tabIndex = on ? 0 : -1;
        if (on) t.classList.add('seen');
      });
      panels.forEach((p, j) => p.classList.toggle('on', j === i));
      if (focus) tabs[i].focus();
    };
    tabs.forEach((t, i) => {
      t.addEventListener('click', () => show(i));
      // Arrow keys move along the timeline, as in any set of tabs
      t.addEventListener('keydown', (e) => {
        const step = { ArrowRight: 1, ArrowDown: 1, ArrowLeft: -1, ArrowUp: -1 }[e.key];
        if (step) { e.preventDefault(); show((i + step + tabs.length) % tabs.length, true); }
        if (e.key === 'Home') { e.preventDefault(); show(0, true); }
        if (e.key === 'End') { e.preventDefault(); show(tabs.length - 1, true); }
      });
    });
  }
</script>

<style>
  .story { max-width: 1080px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  h2 { font-family: var(--font-body); font-weight: var(--w-bold); letter-spacing: var(--track-display); font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 var(--space-title); }
  .lede { font-size: 1.25rem; color: var(--muted); margin: 0 0 calc(var(--space-content) + clamp(16px, 3vw, 32px)); } /* extra room above the timeline */

  /* The timeline: one line, five points, a label under each */
  .timeline { position: relative; display: grid; grid-template-columns: repeat(5, minmax(0, 1fr)); margin: 0 0 clamp(32px, 4vw, 48px); }
  .timeline::before { content: ''; position: absolute; left: 10%; right: 10%; top: 15px; height: 2px; background: var(--line); }
  .point { position: relative; display: grid; justify-items: center; gap: 10px; padding: 0 4px; border: 0; background: none; cursor: pointer;
    font: inherit; font-size: 1rem; font-weight: var(--w-medium); color: var(--muted); text-align: center; }
  .node { width: 32px; height: 32px; border-radius: 50%; background: var(--paper); box-shadow: inset 0 0 0 2px var(--line); transition: transform 0.25s, background-color 0.25s, box-shadow 0.25s; }
  .point.seen .node { background: var(--dot); box-shadow: none; }
  .point[aria-selected='true'] { color: var(--ink); }
  .point[aria-selected='true'] .node { transform: scale(1.2); box-shadow: 0 0 0 6px color-mix(in srgb, var(--dot) 28%, transparent); }
  .point:hover .node { transform: scale(1.1); }
  .point[aria-selected='true']:hover .node { transform: scale(1.2); }
  .point:focus-visible { outline: none; }
  .point:focus-visible .node { outline: 2px solid var(--teal); outline-offset: 4px; }

  /* Every stage sits in the same spot, so the section keeps one height as the stages change */
  .panels { display: grid; }
  .panel { grid-area: 1 / 1; display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 80px); align-items: center; visibility: hidden; opacity: 0; } /* text centred against the photo's height */
  .panel.on { visibility: visible; opacity: 1; transition: opacity 0.45s; }
  .text { position: relative; padding-left: 24px; }
  /* As in the module list: a bar of the stage's ring colour down the left */
  .text::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--dot); }
  h3 { margin: 0 0 14px; font-family: var(--font-display); font-weight: var(--w-bold); letter-spacing: var(--track-heading); font-size: clamp(1.7rem, 2.8vw, 2.2rem); line-height: 1.15; color: var(--teal-dark); }
  .step { font-variant-numeric: tabular-nums; }
  .text p { margin: 0; font-size: 1.1rem; line-height: 1.6; color: var(--ink); }
  .text p + p { margin-top: 14px; }
  .photo { margin: 0; aspect-ratio: 5 / 5.6; max-width: 100%; }
  .photo img { display: block; width: 100%; height: 100%; object-fit: cover; border-radius: 18px; box-shadow: var(--lift); background: var(--cream); }

  /* Placeholders are obviously unfinished so they can't go live by mistake */
  .placeholder h3, .placeholder p { color: #8a918f; font-style: italic; }
  .tag { display: inline-block; margin-top: 14px; padding: 2px 8px; border: 1px dashed var(--terracotta-dark); border-radius: 6px; font-size: 0.8rem; color: var(--terracotta-dark); }

  /* Phones and narrow tablets: photo above the text, and the section grows or shrinks with each stage */
  @media (max-width: 800px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; }
    .lede { font-size: 18px; line-height: 1.55; margin-bottom: calc(var(--space-content) + 12px); }
    .story { padding-inline: 24px; }
    .timeline { margin-bottom: 28px; }
    .timeline::before { top: 13px; }
    .point { font-size: 13px; gap: 8px; padding: 0; white-space: nowrap; }
    .node { width: 28px; height: 28px; }
    .panel { grid-template-columns: 1fr; gap: 22px; display: none; }
    .panel.on { display: grid; }
    .photo { order: -1; aspect-ratio: 4 / 3; }
    .photo img { border-radius: 14px; }
    .photo img[style*='--mpos'] { object-position: var(--mpos) !important; } /* a phone crop where the shorter photo needs one */
    h3 { font-size: 23px; }
    .text { padding-left: 18px; }
    .text p { font-size: 17px; }
  }
  /* The smallest phones: smaller labels so neighbours never touch */
  @media (max-width: 360px) {
    .point { font-size: 11px; letter-spacing: -0.01em; }
  }
  @media (prefers-reduced-motion: reduce) {
    .node, .panel.on { transition: none; }
  }
</style>
