---
// Peter's story in stages, one photo per stage. A line break in `text` starts a new paragraph.
const stages = [
  {
    img: 'early-years', pos: '45% 30%', w: 1075, h: 1165,
    alt: 'Peter as a baby, held up by a woman, with a young boy beside them',
    title: 'Fostered from three months old',
    text: 'Fostered at three months old, I grew up without money. I still remember how my friends’ dinners always smelled better than ours. I had no idea the scarcity mindset forming in those moments would go on to hurt my finances as an adult. At eight, I was told I was going to Nigeria for a two-week holiday. It lasted ten years.\nI returned from Nigeria in 1998 with £50 in my pocket and, not understanding how money worked, ended up homeless and sleeping on the streets. By 2001 I was in debt, and I stayed there for over a decade.',
    placeholder: false,
  },
  {
    img: 'office', pos: '35% 40%', w: 1199, h: 1200,
    alt: 'Peter at his desk in an office, in a shirt and tie',
    title: 'Canary Wharf',
    text: 'In 2006, I found a job as a bank cashier and worked my way through retail and corporate banking before reaching wealth management in Canary Wharf in 2012. For the first time, I was earning good money, yet I still felt stuck. I understood everyday financial products but knew nothing about investing, and the scarcity mindset from my childhood had me overspending and living for the moment.\nThen a manager showed me I was earning enough to buy my first property. That conversation sparked the biggest mindset shift of my life. I set proper goals, stopped spending aimlessly, cleared debt I’d struggled with for over ten years, bought my first home and finally started investing. Not bad for someone who once slept on the streets.',
    placeholder: false,
  },
  {
    img: 'lorraine', pos: '60% 55%', w: 1200, h: 1200,
    alt: 'Peter being interviewed by Lorraine Kelly on Lorraine',
    title: 'Having the conversations I wish someone had with me',
    text: 'In 2020 I started a YouTube channel, which led to my bestselling book with HarperCollins, The Money Basics: How to Become Your Own Financial Hero, in 2023. I’ve appeared on shows including Lorraine, Steph’s Packed Lunch, Secret Spenders: Beat the Price Rises, Family Budget Switch Up and Jeremy Vine, and as a financial expert on BBC News, Sky News, Channel 5 News and the BBC World Service.',
    placeholder: false,
  },
  {
    img: 'downing-street', pos: '30% 50%', mpos: '30% 29%', w: 900, h: 1200, // mpos: on phones the shorter crop keeps the door number and head in view
    alt: 'Peter outside 10 Downing Street',
    title: 'Advocating for financial education',
    text: 'I ended up sleeping on the streets because I didn’t understand simple budgeting. It’s why I joined a team campaigning for financial education to be made compulsory in primary schools, taking our case from Parliament all the way to Number 10. From September 2028, children in England as young as five will learn the fundamentals of money in school.',
    placeholder: false,
  },
  {
    img: 'stage', pos: '36% 40%', w: 1400, h: 933,
    alt: 'Peter speaking on stage at an awards event',
    title: 'Why Calm Money exists',
    text: 'I’ve come a long way from noticing whose dinner smelled better. But the biggest lesson from that journey is one no textbook taught me: you can understand money and still be controlled by it. One conversation shifted my mindset, but it was the action I took afterwards that changed my life. It took years to realise how many people are stuck where I was, earning, trying, and still not moving forward. Calm Money is my answer to that. A place to stop overthinking your money and start taking the steps that move you forward, so you don’t have to wait as long as I did.',
    placeholder: false,
  },
];
// Each stage's marker takes the next ring colour, in the logo's order
const colours = ['var(--cream-bar)', 'var(--terracotta)', 'var(--blush)', 'var(--sage)', 'var(--teal)'];
---
<section class="story" id="story">
  <h2>Why I built Calm Money.</h2>
  <p class="lede">A programme by Peter Komolafe. This is how it came to be.</p>

  <div class="grid">
    <ol class="chapters">
      {stages.map((s, i) => (
        <li class:list={['chapter', { on: i === 0, placeholder: s.placeholder }]} style={`--dot: ${colours[i]}`} data-chapter={i}>
          {/* Phones: a headline row that opens on tap, one at a time. Wider screens: always open */}
          <details class="more" open>
            <summary>
              <span class="head">
                <span class="step">{String(i + 1).padStart(2, '0')}</span>
                <h3>{s.title}</h3>
              </span>
            </summary>
            <figure class="inline">
              <img src={`/images/story/${s.img}.webp`} width={s.w} height={s.h} alt={s.alt} loading="lazy" decoding="async" style={`object-position: ${s.pos}${'mpos' in s ? `; --mpos: ${s.mpos}` : ''}`} />
            </figure>
            {s.text.split('\n').map((para) => <p>{para}</p>)}
          </details>
          {s.placeholder && <span class="tag">Placeholder</span>}
        </li>
      ))}
    </ol>

    <!-- On wider screens the photo stays in view and changes as each chapter passes -->
    <div class="frame" aria-hidden="true">
      {stages.map((s, i) => (
        <img class:list={{ on: i === 0 }} src={`/images/story/${s.img}.webp`} width={s.w} height={s.h} alt="" loading="lazy" decoding="async" style={`object-position: ${s.pos}`} data-frame={i} />
      ))}
    </div>
  </div>

</section>

<script>
  const story = document.querySelector<HTMLElement>('#story'); // by id: member-story cards also use .story
  if (story) {
    const chapters = [...story.querySelectorAll<HTMLElement>('[data-chapter]')];
    const frames = [...story.querySelectorAll<HTMLElement>('[data-frame]')];
    const show = (i: number) => {
      chapters.forEach((c, j) => c.classList.toggle('on', j === i));
      frames.forEach((f, j) => f.classList.toggle('on', j === i));
    };
    // A chapter takes over once its number reaches the middle of the photo
    const frame = story.querySelector<HTMLElement>('.frame')!;
    const steps = chapters.map((c) => c.querySelector<HTMLElement>('.step')!);
    let current = 0, queued = false;
    const update = () => {
      queued = false;
      if (getComputedStyle(frame).display === 'none') return; // phones: each chapter has its own photo
      const box = frame.getBoundingClientRect();
      const line = box.top + box.height / 2;
      let i = 0;
      steps.forEach((s, j) => { if (s.getBoundingClientRect().top <= line) i = j; });
      if (i !== current) { current = i; show(i); }
    };
    const queue = () => { if (!queued) { queued = true; requestAnimationFrame(update); } };
    addEventListener('scroll', queue, { passive: true });
    addEventListener('resize', queue);
    update();

    // Phones: one chapter open at a time, following the reader. Wider screens keep every chapter open
    const more = [...story.querySelectorAll<HTMLDetailsElement>('details.more')];
    const sums = more.map((d) => d.querySelector<HTMLElement>('summary')!);
    const phone = matchMedia('(max-width: 800px)');
    let active = 0;
    // Open one chapter and close the rest, holding that chapter's row where it is on screen, so a chapter
    // closing above never moves the text under the reader's eyes
    const openOnly = (i: number) => {
      const before = sums[i].getBoundingClientRect().top;
      more.forEach((d, j) => { d.open = j === i; });
      const shift = sums[i].getBoundingClientRect().top - before;
      if (shift) scrollBy(0, shift);
    };
    const fit = () => {
      sums.forEach((sum) => (phone.matches ? sum.removeAttribute('tabindex') : (sum.tabIndex = -1)));
      if (phone.matches) { active = 0; more.forEach((d, j) => (d.open = j === 0)); }
      else more.forEach((d) => (d.open = true));
    };
    fit();
    phone.addEventListener('change', fit);

    // A tap opens that chapter (closing the rest) and brings it up to the reading position, or closes it
    sums.forEach((sum, i) => sum.addEventListener('click', (e) => {
      e.preventDefault();
      if (!phone.matches) return;
      if (more[i].open) { more[i].open = false; return; }
      active = i;
      openOnly(i);
      scrollBy(0, sum.getBoundingClientRect().top - innerHeight * 0.2);
    }));

    // Reading on: the next chapter takes over once its row passes 40% down the screen; going back up, the
    // previous one returns once the current row drops below 60%. The gap between the two stops flicker
    let ticking = false;
    const follow = () => {
      ticking = false;
      if (!phone.matches) return;
      const vh = innerHeight;
      let next = active;
      while (next + 1 < more.length && sums[next + 1].getBoundingClientRect().top <= vh * 0.4) next++;
      while (next > 0 && sums[next].getBoundingClientRect().top > vh * 0.6) next--;
      if (next === active) return;
      active = next;
      openOnly(next);
    };
    addEventListener('scroll', () => { if (!ticking) { ticking = true; requestAnimationFrame(follow); } }, { passive: true });
  }
</script>

<style>
  .story { max-width: 1080px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  h2 { font-family: var(--font-body); font-weight: var(--w-bold); letter-spacing: var(--track-display); font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 14px; }
  .lede { font-size: 1.25rem; color: var(--muted); margin: 0 0 24px; }

  .grid { display: grid; grid-template-columns: minmax(0, 4fr) minmax(0, 5fr); gap: clamp(40px, 6vw, 80px); }
  .chapters { list-style: none; margin: 0; padding: 0; }
  /* Each chapter gets most of a screen, so the photo changes one stage at a time */
  .chapter { min-height: 64vh; display: flex; flex-direction: column; justify-content: center; opacity: 0.65; transition: opacity 0.4s; } /* 0.65: the faded chapters still pass contrast */
  .chapter.on { opacity: 1; }
  .chapter .inline { display: none; }

  .frame { position: sticky; top: calc(50vh - min(34vh, 290px)); height: min(68vh, 580px); margin-top: 18vh; }
  .frame img { position: absolute; inset: 0; width: 100%; height: 100%; object-fit: cover; border-radius: 18px; box-shadow: var(--lift); background: var(--cream); opacity: 0; transition: opacity 0.5s; }
  .frame img.on { opacity: 1; }

  /* As in the module list: a bar of the chapter's ring colour down the left, and a large serif number */
  .more { position: relative; padding-left: 24px; }
  .more::before { content: ''; position: absolute; left: 0; top: 0; bottom: 0; width: 2px; background: var(--dot); }
  .step { display: block; font-family: var(--font-display); font-weight: var(--w-bold); font-size: clamp(1.7rem, 2.4vw, 2rem); line-height: 1; color: var(--teal-dark); font-variant-numeric: tabular-nums; }
  h3 { margin: 12px 0; font-family: var(--font-display); font-weight: var(--w-bold); letter-spacing: var(--track-heading); font-size: clamp(1.7rem, 2.8vw, 2.3rem); line-height: 1.15; color: var(--teal-dark); text-wrap: balance; }
  .chapter p { margin: 0; font-size: 1.1rem; line-height: 1.6; color: var(--ink); }
  .chapter p + p { margin-top: 14px; }

  /* Chapters: on wider screens the summary is just the number and heading */
  .more summary { list-style: none; cursor: default; }
  .more summary::-webkit-details-marker { display: none; }
  .more .head { display: block; }


  /* Placeholders are obviously unfinished so they can't go live by mistake */
  .placeholder h3, .placeholder p { color: #8a918f; font-style: italic; }
  .tag { align-self: flex-start; margin-top: 14px; padding: 2px 8px; border: 1px dashed var(--terracotta-dark); border-radius: 6px; font-size: 0.8rem; color: var(--terracotta-dark); }

  /* Phones and narrow tablets: no sticky frame, each chapter shows its own photo */
  @media (max-width: 800px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; margin-bottom: 20px; }
    .lede { font-size: 18px; line-height: 1.55; }
    h3 { font-size: 23px; }
    .chapter p { font-size: 17px; }
    .story { padding-inline: 24px; }
    .grid { grid-template-columns: 1fr; }
    .frame { display: none; }
    .chapter { min-height: 0; opacity: 1; margin-top: 48px; }
    .chapter .inline { display: block; margin: 0 0 18px; }
    .inline img { display: block; width: 100%; height: auto; max-height: 440px; object-fit: cover; border-radius: 18px; box-shadow: var(--lift); }

    /* Chapters collapse to a row: colour bar, number, heading and a plus, like the module list */
    .chapter:has(.more) { margin-top: 10px; }
    .chapter:first-child { margin-top: 32px; }
    .more { padding-left: 18px; }
    .more summary { cursor: pointer; display: grid; grid-template-columns: 1fr 14px; gap: 12px; align-items: center; padding: 10px 0; }
    .more .head { display: grid; grid-template-columns: 40px 1fr; column-gap: 14px; align-items: center; }
    .step { font-size: 26px; }
    .more h3 { margin: 0; font-size: 20px; }
    .more summary::after { content: ''; width: 14px; height: 14px; background:
        linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
        linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; }
    .more[open] summary::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
    .more summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
    .more .inline { margin: 4px 0 16px; }
    .more .inline img { max-height: 240px; border-radius: 14px; }
    .more .inline img[style*='--mpos'] { object-position: var(--mpos) !important; } /* a phone crop where the shorter photo needs one */
    .more p:last-child { margin-bottom: 12px; }

  }
  @media (prefers-reduced-motion: reduce) {
    .chapter, .frame img { transition: none; }
  }
</style>
