---
// Common questions. Answers in [brackets] are placeholders waiting on Peter's decisions,
// shown grey and italic so they can't go live by mistake.
const faqs = [
  {
    q: 'How much time does it take?',
    a: 'The five modules are 64 short lessons, about 2.5 hours in total, so most people fit them around work. The real time goes into the practical exercises, applying each module to your own money. [How many hours a week members typically spend.]',
  },
  {
    q: 'Is this financial advice?',
    a: 'No. Calm Money is financial education. It teaches you how money works and helps you build your own system, but it does not recommend specific investments or products for you. For regulated advice, speak to a financial adviser authorised by the FCA.',
  },
  {
    q: 'I’m in debt. Is this still for me?',
    a: 'Yes. Module 3, Breaking the Debt Cycle, gives you a clear plan to pay it off, and the programme shows you how to balance clearing debt with building savings and, later, investing.',
  },
  {
    q: 'I’m self-employed. Does it still work?',
    a: '[How the programme handles irregular income, tax and pensions for the self-employed.]',
  },
  {
    q: 'What’s the difference between the three options?',
    a: 'Every option includes all five modules, the money personality test and lifetime access to the content library. At your pace with coaching adds four coaching sessions, one every quarter. 12 months of full support adds an onboarding call, 24 live coaching calls, WhatsApp access to Peter and two in-person meet-ups.',
  },
  {
    q: 'Where are the meet-ups?',
    a: '[Where the meet-ups at months 6 and 12 take place, and who covers travel.]',
  },
  {
    q: 'Can I pay in instalments?',
    a: '[Which options can be paid in instalments, and how.]',
  },
  {
    q: 'What if it’s not right for me?',
    a: '[Refund terms.]',
  },
];
const isPlaceholder = (a: string) => a.includes('[');
---
<section class="faq" id="faq">
  <h2>Common questions.</h2>
  <div class="list">
    {faqs.map((f) => (
      <details>
        <summary>{f.q}</summary>
        <p class:list={{ placeholder: isPlaceholder(f.a) }}>{f.a}</p>
      </details>
    ))}
  </div>
</section>

<style>
  .faq { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  h2 { font-family: var(--font-body); font-weight: 450; letter-spacing: -0.02em; font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 32px; }

  /* No rules between questions: they would fight the page grid. Spacing separates them instead */
  .list { display: grid; gap: 4px; }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 18px 0; font-size: 1.2rem; font-weight: 500; color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  /* A plus that turns into a minus */
  summary::after { content: ''; flex: none; width: 14px; height: 14px; background:
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; transition: rotate 0.2s; }
  details[open] summary::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
  summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
  details p { margin: 0 0 24px; max-width: 62ch; color: var(--muted); font-size: 1.05rem; line-height: 1.6; }
  details p.placeholder { color: #8a918f; font-style: italic; }

  @media (max-width: 760px) {
    .faq { padding-inline: 12px; }
    summary { font-size: 1.1rem; padding: 18px 0; }
  }
</style>
