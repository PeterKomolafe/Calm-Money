---
// Common questions. Answers in [brackets] are placeholders waiting on Peter's decisions,
// shown grey and italic so they can't go live by mistake.
const faqs = [
  {
    q: 'How much time does it take?',
    a: 'The five modules are 64 short lessons, about 2.5 hours in total, so most people fit them around work. The real time goes into the practical exercises, applying each module to your own money.',
  },
  {
    q: 'Is this financial advice?',
    a: 'No. Calm Money is financial education. It teaches you how money works and helps you build your own system, it does not recommend specific investments or products for you. For regulated advice, speak to a financial adviser authorised by the FCA.',
  },
  {
    q: 'I’m in debt. Is this still for me?',
    a: 'Yes. Module 2, Breaking the Debt Cycle, gives you a clear plan to pay it off, and the programme shows you how to balance clearing debt with building savings and, later, investing.',
  },
  {
    q: 'I’m self-employed. Does it still work?',
    a: 'Yes, and it’s especially effective if your income is irregular. When your earnings depend on you, it’s easy to swing between feast and famine. We give you a system to stabilise your finances and end that cycle.',
  },
  {
    q: 'What’s the difference between the three options?',
    a: 'Whichever option you choose, you get all five modules, the money personality test and lifetime access to the content library.\nAt your pace with coaching adds four quarterly coaching sessions with Peter, helping you put what you learn into practice and keeping you accountable to the goals you set in Module 0.\n12 months of full support adds an onboarding call, 24 live coaching calls, WhatsApp access to Peter and two in-person meet-ups.',
  },
  {
    q: 'Where are the meet-ups?',
    a: 'Our in-person meet-ups are in the UK, with dates announced well in advance so you can plan around them and secure your spot.',
  },
  {
    q: 'Can I pay in instalments?',
    a: '[Which options can be paid in instalments, and how.]',
  },
  {
    q: 'What if it’s not right for me?',
    a: 'Our coaching options are built around action, so our guarantee is too. If you’ve taken the first steps and still feel it isn’t right for you, let us know within 30 days of joining and we’ll give you a full refund.\nAt your pace with coaching: complete Module 0 and attend your first coaching session.\n12 months of full support: complete Module 0 and attend your onboarding call.\nNo awkward conversations, no pressure.\nThe At your pace option gives you instant access to all the content, so it isn’t eligible for a refund once you’ve started.',
  },
];
const isPlaceholder = (a: string) => a.includes('[');
---
<section class="faq" id="faq">
  <h2>Common questions.</h2>
  <div class="list">
    <img class="qmark" src="/images/question-mark.webp" width="481" height="700" alt="" aria-hidden="true" loading="lazy" />
    {faqs.map((f) => (
      <details name="faq">
        <summary>{f.q}</summary>
        {f.a.split('\n').map((para) => <p class:list={{ placeholder: isPlaceholder(para) }}>{para}</p>)}
      </details>
    ))}
  </div>
</section>

<script>
  // One answer open at a time. The name attribute does this in current browsers; this covers older ones
  const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq details')];
  items.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) items.forEach((o) => { if (o !== d) o.open = false; });
  }));
</script>

<style>
  .faq { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  /* The question mark sits in the open space between the questions and the plus signs, tilted.
     It starts one full heading height above the heading, and stays put as answers open */
  .list { position: relative; }
  .qmark { position: absolute; left: 74%; top: calc(-32px - 1.72 * 1.02 * clamp(2.2rem, 4.2vw, 3.5rem)); /* visible top sits one full heading height above the heading (the tilt lifts it slightly) */ translate: -50% 0; rotate: 14deg; width: clamp(125px, 12vw, 160px); height: auto; pointer-events: none; }
  h2 { font-family: var(--font-body); font-weight: 450; letter-spacing: -0.02em; font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 32px; }

  /* No rules between questions: they would fight the page grid. Spacing separates them instead */
  .list { display: grid; gap: 4px; }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 18px 0; font-size: 1.2rem; font-weight: 500; color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  /* A plus that turns into a minus */
  summary::after { content: ''; flex: none; width: 14px; height: 14px; background:
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; transition: rotate 0.2s; }
  details[open] summary::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
  summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
  details p + p { margin-top: -12px; }
  details p { margin: 0 0 24px; max-width: min(62ch, 58%); color: var(--muted); font-size: 1.05rem; line-height: 1.6; }
  details p.placeholder { color: #8a918f; font-style: italic; }

  @media (max-width: 900px) {
    .qmark { display: none; }
    details p { max-width: 62ch; }
  }
  @media (max-width: 760px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; }
    details p { font-size: 17px; }
    .faq { padding-inline: 20px; }
    summary { font-size: 19px; padding: 18px 0; }
  }
</style>
