---
// Common questions. Answers in [brackets] are placeholders waiting on Peter's decisions,
// shown grey and italic so they can't go live by mistake.
const faqs = [
  {
    q: 'How much time does it take?',
    a: 'The five modules are 64 short lessons, about 2.5 hours in total, so most people fit them around work. The real time goes into the practical exercises, applying each module to your own money.',
  },
  {
    q: 'Is this financial advice?',
    a: 'No. Calm Money is financial education. It teaches you how money works and helps you build your own system, it does not recommend specific investments or products for you. For regulated advice, speak to a financial adviser authorised by the FCA.',
  },
  {
    q: 'I’m in debt. Is this still for me?',
    a: 'Yes. Module 2, Breaking the Debt Cycle, gives you a clear plan to pay it off, and the programme shows you how to balance clearing debt with building savings and, later, investing.\n“I realise some things take time to resolve. As long as I’m engaging with my creditors, and not burying my head in the sand, they do understand.” Jean M., founding member',
  },
  {
    q: 'I’m self-employed. Does it still work?',
    a: 'Yes, and it’s especially effective if your income is irregular. When your earnings depend on you, it’s easy to swing between feast and famine. We give you a system to stabilise your finances and end that cycle.',
  },
  {
    q: 'What’s the difference between the three options?',
    a: 'Whichever option you choose, you get all five modules, the money personality test, the practical tools, the Calm Money community, Peter’s monthly update and the workshop library, with 12 months’ access that you can renew at the end.\nAt your pace with coaching adds an onboarding call and four quarterly coaching sessions with Peter, helping you put what you learn into practice and keeping you accountable to the goals you set in Module 0.\n12 months of full support includes everything in At your pace with coaching, plus 12 monthly live group calls, WhatsApp access to Peter and two in-person meet-ups.',
  },
  {
    q: 'What is the monthly update?',
    a: 'A short recorded video from Peter each month on what’s changed in UK money, such as interest rates, inflation or the Budget, and what it means for your debt, your safety net and your investing. It also includes a seasonal check of your system and one action for the month.\nIt’s general education, not financial advice. It isn’t live, so questions for Peter belong in your coaching sessions or live calls.',
  },
  {
    q: 'Where are the meet-ups?',
    a: 'Our in-person meet-ups are in the UK, with dates announced well in advance so you can plan around them and secure your spot.',
  },
  {
    q: 'Can I pay in instalments?',
    a: 'Yes. At your pace with coaching can be paid as £397 today, then 9 monthly payments of £100. That’s £1,297 in total, with no interest and no extra charge. 12 months of full support can also be paid in instalments, and we’ll set out the options when your place in an intake is confirmed. At your pace is paid upfront.\nIf you’re currently paying off high-interest debt, don’t put this on a credit card. Start with At your pace and focus on Module 2 first. You can move up to coaching later.',
  },
  {
    id: 'guarantee', // the pricing section's guarantee line links here
    q: 'What if it’s not right for me?',
    a: 'Our coaching options are built around action, so our guarantee is too. If you’ve taken the first steps and still feel it isn’t right for you, let us know within 30 days of joining and we’ll give you a full refund.\nAt your pace with coaching: complete Module 0 and attend your onboarding call.\n12 months of full support: complete Module 0 and attend your onboarding call.\nNo awkward conversations, no pressure.\nThe At your pace option gives you instant access to all the content, so it isn’t eligible for a refund once you’ve started.',
  },
];
const isPlaceholder = (a: string) => a.includes('[');
---
<section class="faq" id="faq">
  <h2>Common questions.</h2>
  <div class="list">
    <img class="qmark" src="/images/question-mark.webp" width="330" height="480" alt="" aria-hidden="true" loading="lazy" />
    {faqs.map((f) => (
      <details name="faq" id={f.id}>
        <summary>{f.q}</summary>
        {f.a.split('\n').map((para) => <p class:list={{ placeholder: isPlaceholder(para), member: para.startsWith('“') }}>{para}</p>)}
      </details>
    ))}
  </div>
</section>

<script>
  // One answer open at a time. The name attribute does this in current browsers; this covers older ones
  const items = [...document.querySelectorAll<HTMLDetailsElement>('.faq details')];
  items.forEach((d) => d.addEventListener('toggle', () => {
    if (d.open) items.forEach((o) => { if (o !== d) o.open = false; });
  }));
  // A link straight to one answer (#guarantee) opens it
  const openFromHash = () => {
    const d = items.find((i) => i.id && '#' + i.id === location.hash);
    if (d) d.open = true;
  };
  openFromHash();
  addEventListener('hashchange', openFromHash);
</script>

<style>
  .faq { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  /* The question mark sits in the open space between the questions and the plus signs, tilted.
     It starts one full heading height above the heading, and stays put as answers open */
  .list { position: relative; }
  .qmark { position: absolute; left: 74%; top: calc(-32px - 1.72 * 1.02 * clamp(2.2rem, 4.2vw, 3.5rem)); /* visible top sits one full heading height above the heading (the tilt lifts it slightly) */ translate: -50% 0; rotate: 14deg; width: clamp(125px, 12vw, 160px); height: auto; pointer-events: none; }
  h2 { font-family: var(--font-body); font-weight: var(--w-bold); letter-spacing: var(--track-display); font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 var(--space-content); }

  /* No rules between questions: they would fight the page grid. Spacing separates them instead */
  .list { display: grid; gap: 4px; }
  summary { list-style: none; cursor: pointer; display: flex; justify-content: space-between; align-items: center; gap: 24px; padding: 18px 0; font-size: 1.2rem; font-weight: var(--w-medium); color: var(--ink); }
  summary::-webkit-details-marker { display: none; }
  /* A plus that turns into a minus */
  summary::after { content: ''; flex: none; width: 14px; height: 14px; background:
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat,
      linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 2px 100% no-repeat; transition: rotate 0.2s; }
  details[open] summary::after { background: linear-gradient(var(--terracotta-dark), var(--terracotta-dark)) center / 100% 2px no-repeat; }
  summary:focus-visible { outline: 2px solid var(--teal); outline-offset: 4px; }
  details p + p { margin-top: -12px; }
  details p { margin: 0 0 24px; max-width: min(62ch, 58%); color: var(--muted); font-size: 1.05rem; line-height: 1.6; }
  details p.placeholder { color: #8a918f; font-style: italic; }

  @media (max-width: 900px) {
    .qmark { display: none; }
    details p { max-width: 62ch; }
  }
  @media (max-width: 760px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; }
    details p { font-size: 17px; }
    .faq { padding-inline: 24px; }
    summary { font-size: 19px; padding: 18px 0; }
  }
  /* A member's words inside an answer */
  .member { font-style: italic; padding-left: 14px; border-left: 2px solid var(--blush); }
</style>
