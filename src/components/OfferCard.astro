---
import type { CollectionEntry } from 'astro:content';
interface Props { offer: CollectionEntry<'offers'> }
const { offer } = Astro.props;
const d = offer.data;
---
<article class:list={['card', 'offer', { featured: d.featured }]}>
  {d.featured && <p class="eyebrow">Most popular</p>}
  <h3>{d.title}</h3>
  <p class="price">{d.price}</p>
  <p>{d.summary}</p>
  {d.includes.length > 0 && <ul class="ticks">{d.includes.map((i) => <li>{i}</li>)}</ul>}
  <a class="btn btn--primary" href={d.cta_url}>{d.cta_label}</a>
</article>

<style>
  .offer { display: flex; flex-direction: column; }
  .offer .btn { margin-top: auto; align-self: flex-start; }
  .featured { border: 2px solid var(--terracotta); }
  .price { font-family: var(--font-display); font-size: 1.8rem; color: var(--teal); margin-bottom: 0.5em; }
</style>
