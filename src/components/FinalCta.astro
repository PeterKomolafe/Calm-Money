---
// Closing call to action, on the same deep-teal lifted card as the calculator.
---
<section class="final" aria-labelledby="final-heading">
  <div class="card">
    <h2 id="final-heading">Staying where you are for another year will cost more than this programme.</h2>
    <a class="btn btn--light" href="#pricing">Join the programme</a>
  </div>
</section>

<style>
  .final { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  .card { display: grid; justify-items: center; gap: 22px; text-align: center; padding: clamp(32px, 4vw, 48px) clamp(24px, 4vw, 48px);
    border-radius: 28px; background: linear-gradient(180deg, #3d5453, #34494a 40%); color: var(--cream); box-shadow: var(--lift); }
  h2 { margin: 0; color: var(--cream); font-family: var(--font-display); font-weight: 400; font-size: clamp(1.7rem, 3.2vw, 2.6rem); line-height: 1.2; max-width: 22em; text-wrap: balance; }
  .btn--light { background: var(--cream); color: var(--ink); }
  .btn--light:hover { background: #fff; color: var(--ink); }

  @media (max-width: 760px) {
    .final { padding-inline: 24px; }
    .card { border-radius: 20px; }
  }
</style>
