---
// Closing call to action, on the same deep-teal lifted card as the calculator. A member's words are the headline.
---
<section class="final" aria-labelledby="final-heading">
  <div class="card">
    <figure class="member">
      <blockquote><p id="final-heading">“You may not be doing anything wrong, but you could be doing it better with <em class="stroke">the right roadmap.”</em></p></blockquote>
      <figcaption>Jean M. · Founding member</figcaption>
    </figure>
    <a class="btn btn--light" href="#pricing">Join Calm Money</a>
  </div>
</section>

<style>
  .final { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  .card { display: grid; justify-items: center; gap: 22px; text-align: center; padding: clamp(32px, 4vw, 48px) clamp(24px, 4vw, 48px);
    border-radius: 28px; background: linear-gradient(180deg, #3d5453, #34494a 40%); color: var(--cream); box-shadow: var(--lift); }
  /* Jean's words are the closing headline */
  .member { margin: 0; }
  .member blockquote { margin: 0; }
  /* Sized so the quote sits on two lines on desktop and tablet */
  .member p { margin: 0 auto; color: var(--cream); font-family: var(--font-display); font-weight: var(--w-bold); letter-spacing: var(--track-heading);
    font-size: clamp(1.25rem, 2.35vw, 1.95rem); line-height: 1.25; text-wrap: balance; }
  .member em { font-style: normal; }
  .member figcaption { margin-top: 18px; font-size: 1rem; font-weight: var(--w-medium); color: #d6d1c6; }
  .btn--light { background: var(--cream); color: var(--ink); }
  .btn--light:hover { background: #fff; color: var(--ink); }

  @media (max-width: 760px) {
    .final { padding-inline: 24px; }
    .card { border-radius: 20px; }
  }
</style>
