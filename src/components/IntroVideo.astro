---
import site from '../data/site.json';
// Peter's intro video, between the hero and "This is for you if".
// A cover image with a play button stands in until it's pressed; only then does the Bunny player load,
// so nothing is fetched from Bunny for visitors who don't watch. The embed URL lives in src/data/site.json.
---
<section class="intro" aria-label="Meet Peter">
  <figure>
    <div class="frame" data-src={`${site.intro_video_embed}?autoplay=true&preload=true&responsive=true`}>
      <button class="poster" type="button" aria-label="Play: Meet Peter">
        <img src="/images/story/stage.webp" width="1400" height="933" alt="" loading="lazy" decoding="async" />
        <span class="play" aria-hidden="true"></span>
      </button>
    </div>
    <figcaption><b>Meet Peter.</b> Why money can feel hard even when you earn well, and how Calm Money helps.</figcaption>
  </figure>
</section>

<script>
  document.querySelectorAll<HTMLElement>('.intro .frame').forEach((frame) => {
    frame.querySelector('button')!.addEventListener('click', () => {
      const iframe = document.createElement('iframe');
      iframe.src = frame.dataset.src!;
      iframe.title = 'Meet Peter';
      iframe.allow = 'accelerometer; gyroscope; autoplay; encrypted-media; picture-in-picture; fullscreen';
      iframe.allowFullscreen = true;
      frame.replaceChildren(iframe);
      iframe.focus();
    });
  });
</script>

<style>
  .intro { max-width: 1120px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  figure { margin: 0 auto; max-width: 860px; }
  .frame { position: relative; width: 100%; aspect-ratio: 16 / 9; border-radius: 18px; overflow: hidden; box-shadow: var(--lift); background: var(--ink); }
  .frame :global(iframe) { position: absolute; inset: 0; width: 100%; height: 100%; border: 0; }
  .poster { all: unset; position: absolute; inset: 0; cursor: pointer; }
  .poster:focus-visible { outline: 3px solid var(--teal); outline-offset: -3px; }
  .poster img { width: 100%; height: 100%; object-fit: cover; display: block; filter: brightness(0.82); transition: filter 0.2s; }
  .poster:hover img { filter: brightness(0.9); }
  .play { position: absolute; left: 50%; top: 50%; translate: -50% -50%; width: 84px; height: 84px; border-radius: 50%; background: var(--terracotta); box-shadow: 0 6px 20px rgb(31 38 36 / 0.3); }
  .play::after { content: ''; position: absolute; left: 33px; top: 26px; border-left: 26px solid #fff; border-top: 16px solid transparent; border-bottom: 16px solid transparent; }
  figcaption { margin-top: var(--space-content); color: var(--muted); font-size: 1.05rem; text-align: center; }
  figcaption b { color: var(--ink); font-weight: var(--w-medium); }
  @media (max-width: 800px) {
    .intro { padding-inline: 24px; }
    .frame { border-radius: 14px; }
    .play { width: 64px; height: 64px; }
    .play::after { left: 25px; top: 19px; border-left-width: 20px; border-top-width: 13px; border-bottom-width: 13px; }
    figcaption { font-size: 17px; text-align: left; }
  }
  @media (prefers-reduced-motion: reduce) { .poster img { transition: none; } }
</style>
