---
// Small CALM MONEY wordmark with the ring as the O, sized to the font's cap height (never larger).
// Same construction as the hero wordmark, for the header and anywhere else the name appears.
import Logo from './Logo.astro';
interface Props { class?: string }
const { class: className } = Astro.props;
---
<span class:list={['wordmark', className]} aria-hidden="true">Calm M<span class="wm-slot"><Logo size={100} title="" /></span>ney</span>

<script>
  const fitAll = () => {
    const ctx = document.createElement('canvas').getContext('2d')!;
    document.querySelectorAll<HTMLElement>('.wm-slot').forEach((slot) => {
      const svg = slot.querySelector<SVGElement>('svg')!;
      const cs = getComputedStyle(slot.parentElement!);
      ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
      const cap = ctx.measureText('H').actualBoundingBoxAscent;
      const o = ctx.measureText('O');
      const tracking = parseFloat(cs.letterSpacing) || 0;
      const slotW = cap + (o.width - (o.actualBoundingBoxLeft + o.actualBoundingBoxRight)) + tracking;
      const svgS = cap / 0.822; // the ring's outer diameter is 82.2% of its viewBox
      Object.assign(slot.style, { width: `${slotW}px`, height: `${cap}px` });
      Object.assign(svg.style, { width: `${svgS}px`, height: `${svgS}px`, left: `${(slotW - svgS) / 2}px`, bottom: `${-(svgS - cap) / 2}px` });
      slot.classList.add('ready');
    });
  };
  document.fonts.ready.then(fitAll);
  window.addEventListener('resize', fitAll);
</script>

<style>
  .wordmark { font-family: var(--font-body); font-weight: 450; text-transform: uppercase; letter-spacing: 0.02em; line-height: 1; white-space: nowrap; color: var(--teal); }
  .wm-slot { display: inline-block; position: relative; width: 0.75em; height: 0.7em; }
  .wm-slot :global(svg) { position: absolute; visibility: hidden; }
  .wm-slot.ready :global(svg) { visibility: visible; }
</style>
