---
// Goal calculator: pick a goal, fill in the sentence, get the month you reach it.
// All maths runs in the browser; nothing is sent anywhere.
---
<section class="calc" id="calculator" data-goal="debt">
  <div class="wrap">
  <h2 id="goal-heading">What’s your goal?</h2>
  <!-- Goals as ledger index tabs on the card's top edge; short labels on phones -->
  <fieldset class="goals" aria-labelledby="goal-heading">
    <label><input type="radio" name="goal" value="debt" checked /><span><span class="full">Get debt free</span><span class="short" aria-hidden="true">Debt free</span></span></label>
    <label><input type="radio" name="goal" value="secure" /><span><span class="full">Get financially secure</span><span class="short" aria-hidden="true">Secure</span></span></label>
    <label><input type="radio" name="goal" value="wealth" /><span><span class="full">Build wealth</span><span class="short" aria-hidden="true">Wealth</span></span></label>
  </fieldset>
  <!-- £50 roll tucked behind the card's top-right corner (a nod to the £50 in Peter's story). Bank of England consent needed before launch -->
  <div class="card-stack">
  <img class="roll" src="/images/banknote/fifty-roll.png" width="684" height="1000" alt="" aria-hidden="true" loading="lazy" />
  <div class="card">
  <p class="sentence" data-panel="debt">
    I owe <span class="in">£<input data-k="owe" inputmode="decimal" value="8,500" aria-label="Total debt in pounds" /></span>
    at an average of <span class="in"><input data-k="apr" inputmode="decimal" value="22" aria-label="Average interest rate, APR percent" />%</span> APR,
    and I can put <span class="in">£<input data-k="pay" inputmode="decimal" value="300" aria-label="Amount towards the debt each month, in pounds" /></span> a month towards it.
  </p>
  <div data-panel="secure" hidden>
    <p class="sentence">
      My essentials cost <span class="in">£<input data-k="essentials" inputmode="decimal" value="1,800" aria-label="Monthly essential costs in pounds" /></span> a month.
      I have <span class="in">£<input data-k="saved" inputmode="decimal" value="1,000" aria-label="Savings so far in pounds" /></span> saved,
      and I can add <span class="in">£<input data-k="add" inputmode="decimal" value="250" aria-label="Monthly saving in pounds" /></span> a month.
    </p>
    <fieldset class="months">
      <legend class="sr-only">Size of emergency fund</legend>
      <label><input type="radio" name="months" value="3" checked /><span>3 months</span></label>
      <label><input type="radio" name="months" value="6" /><span>6 months</span></label>
    </fieldset>
  </div>
  <p class="sentence" data-panel="wealth" hidden>
    I have <span class="in">£<input data-k="invested" inputmode="decimal" value="1,500" aria-label="Amount you have invested so far, in pounds" /></span> invested,
    and I can invest <span class="in">£<input data-k="add" inputmode="decimal" value="250" aria-label="Amount you can invest each month, in pounds" /></span> a month.
  </p>

  <div class="result">
    <div aria-live="polite">
      <p class="label" data-label>You could be debt free by</p>
      <p class="date" data-out>&nbsp;</p>
      <p class="note" data-note></p>
    </div>
  </div>

  <p class="fine" data-panel="debt">Assumes a fixed interest rate and no new borrowing. An estimate, not financial advice.</p>
  <p class="fine" data-panel="secure" hidden>Based on your essential monthly costs. An estimate, not financial advice.</p>
  <p class="fine" data-panel="wealth" hidden>Counts the money you put in, not investment growth. The value of investments can go down as well as up and you may get back less than you put in. This is not financial advice.</p>
  </div>
  </div>
  </div>

  <!-- Bridge: turns the visitor's own result into the case for a system -->
  <div class="bridge" aria-live="polite">
    <!-- Peter's hand-drawn arrow, as in the hero, leading from the card down to what the result means -->
    <span class="down" style="--src: url(/images/notes/arrow.png)" aria-hidden="true"></span>
    <p class="big" data-bridge></p>
    <p class="turn" data-turn></p>
  </div>
</section>

<script>
  // Build wealth milestone: counts contributions only, so no growth rate is assumed
  const FIRST_INVESTED = 10_000;
  const MAX_MONTHS = 50 * 12;

  const root = document.querySelector<HTMLElement>('#calculator')!;
  const fmtDate = new Intl.DateTimeFormat('en-GB', { month: 'long', year: 'numeric' });
  const gbp = (n: number) => `£${Math.round(n).toLocaleString('en-GB')}`;

  const input = (goal: string, k: string) =>
    root.querySelector<HTMLInputElement>(`[data-panel="${goal}"] [data-k="${k}"]`)!;
  const num = (goal: string, k: string) => {
    const n = parseFloat(input(goal, k).value.replace(/[^0-9.]/g, ''));
    return Number.isFinite(n) ? n : 0;
  };
  const inMonths = (n: number) => {
    const d = new Date();
    d.setDate(1);
    d.setMonth(d.getMonth() + n);
    return fmtDate.format(d);
  };
  const span = (n: number) => {
    const y = Math.floor(n / 12), m = n % 12;
    const parts = [];
    if (y) parts.push(`${y} year${y > 1 ? 's' : ''}`);
    if (m) parts.push(`${m} month${m > 1 ? 's' : ''}`);
    return parts.join(' and ') || 'this month';
  };

  // months and monthly are set when there is a real date to reach
  type Result = { label: string; date: string; note: string; months?: number; monthly?: number };

  const calc: Record<string, () => Result> = {
    debt() {
      const label = 'You could be debt free by';
      // UK APR already includes monthly compounding, so convert it to the equivalent monthly rate
      const owe = num('debt', 'owe'), pay = num('debt', 'pay'), r = Math.pow(1 + num('debt', 'apr') / 100, 1 / 12) - 1;
      if (owe <= 0) return { label, date: 'Already there', note: 'No debt to clear.' };
      if (pay <= owe * r) return { label, date: 'Not yet', note: `At this payment the interest (about ${gbp(owe * r)} a month) keeps pace with you. Try a higher monthly payment.` };
      const n = r === 0 ? Math.ceil(owe / pay) : Math.ceil(-Math.log(1 - (r * owe) / pay) / Math.log(1 + r));
      if (n > MAX_MONTHS) return { label, date: 'Over 50 years', note: 'Try a higher monthly payment.' };
      // Interest = everything paid minus what was owed; the final payment only clears what is left
      let bal = owe, paid = 0;
      for (let i = 0; i < n; i++) { bal *= 1 + r; const p = Math.min(pay, bal); paid += p; bal -= p; }
      return { label, date: inMonths(n), note: `That's ${span(n)} away, with roughly ${gbp(paid - owe)} paid in interest.`, months: n, monthly: pay };
    },
    secure() {
      const months = Number(root.querySelector<HTMLInputElement>('input[name="months"]:checked')!.value);
      // Mirrors Peter's note: 3 months = breathing space, 6 months = peace
      const label = months === 3 ? 'You could have 3 months of breathing space by' : 'You could have 6 months of peace of mind by';
      const target = num('secure', 'essentials') * months, saved = num('secure', 'saved'), add = num('secure', 'add');
      if (target <= 0) return { label, date: ' ', note: 'Add your monthly essentials to see your date.' };
      if (saved >= target) return { label, date: 'Already there', note: `You already have ${months} months covered.` };
      if (add <= 0) return { label, date: 'Not yet', note: 'Add something each month to get a date.' };
      const n = Math.ceil((target - saved) / add);
      if (n > MAX_MONTHS) return { label, date: 'Over 50 years', note: 'Try a higher monthly amount.' };
      return { label, date: inMonths(n), note: `Your target is ${gbp(target)}. That's ${span(n)} away.`, months: n, monthly: add };
    },
    wealth() {
      const label = 'You could have your first £10,000 invested by';
      const invested = num('wealth', 'invested'), add = num('wealth', 'add');
      if (invested >= FIRST_INVESTED) return { label, date: 'Already there', note: 'You have put in your first £10,000.' };
      if (add <= 0) return { label, date: 'Not yet', note: 'Add something each month to get a date.' };
      const n = Math.ceil((FIRST_INVESTED - invested) / add);
      if (n > MAX_MONTHS) return { label, date: 'Over 50 years', note: 'Try a higher monthly amount.' };
      return { label, date: inMonths(n), note: `${gbp(FIRST_INVESTED - invested)} to go. That's ${span(n)} away.`, months: n, monthly: add };
    },
  };

  // How each goal's monthly habit is described in the bridge
  const habit: Record<string, (amount: string) => string> = {
    debt: (a) => `putting <b>${a}</b> towards your debt`,
    secure: (a) => `saving <b>${a}</b>`,
    wealth: (a) => `investing <b>${a}</b>`,
  };

  // Two hand-drawn strokes under the "A system..." sentence: a full one rising gently to the right,
  // then a shorter one set in beneath it, both clear of the letters
  const UNDERLINE = '<svg viewBox="0 0 300 30" preserveAspectRatio="none" aria-hidden="true"><path d="M3 10 C 90 7, 190 4, 297 2" /><path d="M24 25 C 100 22, 180 20, 246 19" /></svg>';
  const underlined = (text: string) => `<span class="underlined">${text}${UNDERLINE}</span>`;

  const update = () => {
    const goal = root.dataset.goal!;
    const { label, date, note, months, monthly } = calc[goal]();
    root.querySelector('[data-label]')!.textContent = label;
    root.querySelector('[data-out]')!.textContent = date;
    root.querySelector('[data-note]')!.textContent = note;

    const bridge = root.querySelector('[data-bridge]')!, turn = root.querySelector('[data-turn]')!;
    if (months && monthly) {
      const m = `${months}\u00a0month${months > 1 ? 's' : ''}`; // non-breaking: keeps '39 months' on one line
      bridge.innerHTML = `${date} depends on ${habit[goal](gbp(monthly))} <b>every month for&nbsp;${m}</b>, without missing one.`;
      turn.innerHTML = `Willpower won’t carry you for ${m}.<br class="wide-only"> ${underlined('A system will.')}`;
    } else if (date === 'Already there') {
      bridge.textContent = 'You’re already there.';
      turn.innerHTML = underlined('A system is what keeps you there.');
    } else {
      bridge.textContent = 'Right now, there’s no date to aim for.';
      turn.innerHTML = underlined('A system is how you get one.');
    }
    // Lets the system section highlight the module for this goal
    document.dispatchEvent(new CustomEvent('calm:goal', { detail: { goal } }));
  };

  // Size each inline field to its text (measured, since commas are narrower than digits)
  const measure = document.createElement('canvas').getContext('2d')!;
  const fit = (el: HTMLInputElement) => {
    const cs = getComputedStyle(el);
    measure.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    el.style.width = `${Math.ceil(measure.measureText(el.value || '0').width) + 2}px`;
  };

  root.querySelectorAll<HTMLInputElement>('input[name="goal"]').forEach((r) =>
    r.addEventListener('change', () => {
      root.dataset.goal = r.value;
      root.querySelectorAll<HTMLElement>('[data-panel]').forEach((p) => (p.hidden = p.dataset.panel !== r.value));
      update();
    }),
  );
  root.querySelectorAll<HTMLInputElement>('input[data-k]').forEach((el) => {
    fit(el);
    el.addEventListener('input', () => { fit(el); update(); });
    el.addEventListener('blur', () => {
      const n = parseFloat(el.value.replace(/[^0-9.]/g, ''));
      el.value = Number.isFinite(n) ? n.toLocaleString('en-GB', { maximumFractionDigits: 2 }) : '0';
      fit(el);
      update();
    });
  });
  root.querySelectorAll<HTMLInputElement>('input[name="months"]').forEach((el) => el.addEventListener('change', update));
  document.fonts.ready.then(() => root.querySelectorAll<HTMLInputElement>('input[data-k]').forEach(fit));
  update();
</script>

<style>
  /* The calculator sits on a deep-teal card lifted off the ledger page.
     On this dark surface blush replaces terracotta as the accent (terracotta is ~1.9:1 here). */
  .calc {
    --card: #34494a; --card-top: #3d5453;
    --on-card: #f5e8d8;       /* cream, 7.8:1 */
    --on-card-muted: #bbb8ad; /* 4.7:1 */
    --on-card-quiet: #9ea098; /* large text only */
    --card-accent: #e6a89c;   /* blush, 4.7:1 */
    padding: var(--section-gap) 32px 0; /* each section adds the shared gap above itself */
  }
  .wrap { position: relative; max-width: 920px; margin: 0 auto; }
  .calc { overflow-x: clip; } /* the roll may reach past the edge on narrow screens */
  /* Behind the card (z-index 0 against the card's 1): centred on the card's top edge so only the top half shows.
     The photo's own shadow is kept, so no extra shadow here. */
  .card-stack { position: relative; }
  .roll { position: absolute; z-index: 0; top: 0; right: -96px; width: 300px; height: auto; translate: 0 -50%; pointer-events: none; }
  .card {
    position: relative;
    z-index: 1; /* above unselected tabs, below the selected one */
    container-type: inline-size; /* text below scales with the card, not the window */
    background: linear-gradient(180deg, var(--card-top), var(--card) 40%);
    color: var(--on-card);
    border-radius: 28px;
    padding: clamp(28px, 4vw, 56px);
    box-shadow: var(--lift);
  }

  /* Question and date share the wordmark's typeface and weight */
  /* The question sits on the page above the tabs, aligned with the first tab */
  h2 { font-family: var(--font-body); font-weight: 450; letter-spacing: -0.02em; font-size: clamp(2rem, 3.4vw, 3rem); line-height: 1; color: var(--ink); margin: 0 0 24px; padding: 0 28px; }

  fieldset { border: 0; margin: 0; padding: 0; }
  fieldset label { position: relative; cursor: pointer; }
  fieldset input { position: absolute; inset: 0; opacity: 0; margin: 0; cursor: pointer; }
  .months input:focus-visible + span { outline: 3px solid var(--card-accent); outline-offset: 3px; }

  /* Ledger index tabs: unselected tabs sit just behind the card; the selected tab joins it */
  .goals { display: flex; gap: 6px; padding: 0 28px; margin: 0 0 -6px; }
  .goals label { position: relative; z-index: 0; }
  .goals > label > span {
    display: block; padding: 13px 22px 19px; border-radius: 14px 14px 0 0;
    font-family: var(--font-body); font-weight: 500; font-size: 1.05rem; line-height: 1.2;
    background: #2e4041; color: var(--on-card-muted);
    box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.06), 0 -2px 6px rgb(31 38 36 / 0.10);
    transition: background-color 0.15s, color 0.15s;
  }
  .goals label:hover > span { background: #334647; color: var(--on-card); }
  .goals label:has(input:checked) { z-index: 2; }
  .goals input:checked + span { background: var(--card-top); color: var(--on-card); box-shadow: inset 0 1px 0 rgb(255 255 255 / 0.10); }
  .goals input:focus-visible + span { outline: 3px solid var(--card-accent); outline-offset: -5px; }
  .short { display: none; }

  .sentence { font-size: clamp(1.3rem, 3.6cqi, 1.8rem); line-height: 1.9; margin: 0; text-wrap: pretty; }
  .in { display: inline-flex; align-items: baseline; border-bottom: 2px solid var(--card-accent); color: var(--on-card); font-weight: 600; padding: 0 4px; margin: 0 2px; }
  .in input { font: inherit; color: inherit; border: 0; background: transparent; padding: 0; width: 5ch; min-width: 1.4ch; font-variant-numeric: tabular-nums; }
  .in input:focus { outline: none; }
  .in:focus-within { background: rgb(245 232 216 / 0.10); }

  .months { display: flex; gap: 28px; margin-top: 18px; }
  .months span { display: inline-block; font-weight: 500; color: var(--on-card-muted); }
  .months input:checked + span { color: var(--on-card); box-shadow: inset 0 -2px 0 var(--card-accent); }

  .result { margin-top: 40px; padding-top: 32px; border-top: 1px solid rgb(245 232 216 / 0.22); }
  .label { font-size: 1.1rem; color: var(--on-card-muted); margin: 0 0 6px; }
  .date { font-family: var(--font-body); font-weight: 450; letter-spacing: -0.03em; font-size: clamp(3.4rem, 11.5cqi, 6rem); line-height: 0.95; color: var(--on-card); margin: 0; white-space: nowrap; }
  .note { color: var(--on-card-muted); margin: 12px 0 0; }
  .fine { font-size: 0.85rem; color: var(--on-card-muted); margin: 28px 0 0; }

  .bridge { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; container-type: inline-size; }
  .bridge p { margin: 0; text-wrap: pretty; }
  /* Centred in the gap between the card and the text */
  .bridge { position: relative; }
  .down { position: absolute; left: 50%; top: calc(var(--section-gap) / 2); translate: -50% -50%; width: clamp(18px, 1.9vw, 27px); aspect-ratio: 0.414;
    background: var(--terracotta); -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat; pointer-events: none; }
  /* The setup explains the maths at reading size; the turn below is the statement */
  .big { font-weight: 450; font-size: clamp(1.15rem, 1.7vw, 1.5rem); line-height: 1.45; color: var(--muted); max-width: 36em; }
  .big :global(b) { font-weight: 500; color: var(--ink); }
  /* Desktop: each sentence of the turn on its own line; phones wrap naturally */
  @media (max-width: 760px) { .bridge :global(.wide-only) { display: none; } }
  /* Tablets: the card nearly fills the width, so keep the roll inside the screen */
  @media (max-width: 1100px) { .roll { right: 0; width: 210px; } }
  .bridge :global(.underlined) { position: relative; display: inline-block; white-space: nowrap; }
  .bridge :global(.underlined svg) { position: absolute; left: -2%; top: 104%; width: 104%; height: 0.36em; overflow: visible; pointer-events: none; }
  .bridge :global(.underlined path) { fill: none; stroke: var(--terracotta); stroke-width: 4; stroke-linecap: round; vector-effect: non-scaling-stroke; }
  .bridge .turn { font-family: var(--font-display); font-size: clamp(1.75rem, 5.3cqi, 3.6rem); line-height: 1.15; color: var(--teal); margin-top: 0.5em; padding-bottom: 0.5em; }
  /* Sized to the column so "Willpower won't carry you for N months." fits one line on wider screens: two lines in all */
  @media (min-width: 761px) { .bridge .turn { white-space: nowrap; } }

  @media (max-width: 760px) {
    .bridge { padding-inline: 12px; }
    .bridge :global(.underlined path) { stroke-width: 3; }
    .calc { padding: var(--section-gap) 16px 0; }
    .roll { display: none; } /* no room beside the tabs on phones */
    .card { border-radius: 20px; padding: 28px 20px; }
    h2 { padding: 0 12px; }
    .goals { padding: 0 12px; gap: 4px; }
    .goals label { flex: 1 1 0; }
    .goals > label > span { padding: 11px 6px 17px; font-size: 0.95rem; text-align: center; }
    .full { position: absolute; width: 1px; height: 1px; overflow: hidden; clip: rect(0 0 0 0); white-space: nowrap; } /* still read by screen readers */
    .short { display: inline; }
    .date { white-space: normal; }
  }
</style>
