---
// Member stories: one card per member, built from their questionnaire answers.
// Headline = Q12 (how they feel now); then Q1, Q2, Q3+Q4 and Q10 as labelled lines.
// Only entries with written permission, or placeholders awaiting answers, are shown.
import { getCollection } from 'astro:content';

const entries = (await getCollection('testimonials', (t) => t.data.permission_confirmed || t.data.placeholder))
  .sort((a, b) => a.data.order - b.data.order);

const words = ['', 'One member', 'Two members', 'Three members', 'Four members', 'Five members', 'Six members'];
const count = words[entries.length] ?? `${entries.length} members`;

// Each goal borrows the ring colour of the module that builds it
const goals = {
  debt: { label: 'Get debt free', color: 'var(--blush)' },
  secure: { label: 'Get financially secure', color: 'var(--sage)' },
  wealth: { label: 'Build wealth', color: 'var(--teal)' },
};
const lines = [
  ['before', 'Before joining'],
  ['tipped', 'What tipped it'],
  ['doubt', 'The doubt, and how it looks now'],
  ['doing_now', 'Doing now'],
] as const;
---
{entries.length > 0 && (
  <section class="testimonials" id="results">
    <h2>In their words.</h2>
    <p class="lede">{count} on where they started, what changed, and where they are now.</p>

    <div class="stories">
      {entries.map(({ data: t }) => (
        <article class:list={['story', { placeholder: t.placeholder }]}>
          <header class="who">
            <span class="name">{t.name}</span>
            {t.goal && <span class="goal"><i style={`background:${goals[t.goal].color}`} />{goals[t.goal].label}</span>}
            {t.placeholder && <span class="tag">Placeholder</span>}
          </header>
          <blockquote class="headline"><p>“{t.headline}”</p></blockquote>
          <dl>
            {lines.map(([key, label]) => t[key] && (
              <div><dt>{label}</dt><dd>{t[key]}</dd></div>
            ))}
          </dl>
        </article>
      ))}
    </div>
  </section>
)}

<style>
  .testimonials { max-width: 920px; margin: 0 auto; padding: var(--section-gap) 28px 0; }
  h2 { font-family: var(--font-body); font-weight: 450; letter-spacing: -0.02em; font-size: clamp(2.2rem, 4.2vw, 3.5rem); line-height: 1.02; color: var(--ink); margin: 0 0 14px; }
  .lede { font-size: 1.25rem; color: var(--muted); margin: 0 0 44px; }

  .stories { display: grid; grid-template-columns: repeat(auto-fit, minmax(min(100%, 360px), 1fr)); gap: 32px; }
  /* All stories share one card: brand cream, lifted like the calculator */
  .story { background: var(--cream); border-radius: 22px; padding: clamp(24px, 3vw, 32px) clamp(22px, 3vw, 30px); box-shadow: var(--lift); }

  .who { display: flex; flex-wrap: wrap; justify-content: space-between; align-items: baseline; gap: 6px 16px; padding-bottom: 14px; border-bottom: 1px solid rgb(31 38 36 / 0.12); }
  .name { font-weight: 500; font-size: 1.15rem; color: var(--ink); }
  .goal { display: inline-flex; align-items: center; gap: 8px; font-size: 0.9rem; color: var(--muted); }
  .goal i { width: 10px; height: 10px; border-radius: 50%; flex: none; box-shadow: inset 0 0 0 1px rgb(31 38 36 / 0.08); }

  .headline { margin: 18px 0 26px; }
  .headline p { margin: 0; font-family: var(--font-display); font-size: clamp(1.45rem, 2.4vw, 1.7rem); line-height: 1.25; color: var(--teal-dark); }

  dl { margin: 0; display: grid; gap: 16px; }
  dt { font-size: 0.875rem; font-weight: 600; color: var(--muted); margin-bottom: 3px; }
  dd { margin: 0; font-size: 1.03rem; line-height: 1.45; color: var(--ink); }

  /* Placeholders are obviously unfinished so they can't be mistaken for real members */
  .placeholder .name, .placeholder .headline p, .placeholder dd { color: #8a918f; font-style: italic; }
  .tag { padding: 2px 8px; border: 1px dashed var(--terracotta-dark); border-radius: 6px; font-size: 0.8rem; font-style: normal; color: var(--terracotta-dark); }

  @media (max-width: 760px) {
    /* Mobile type scale: 32 section heading, 23 card heading, 19 small heading, 17 body */
    h2 { font-size: 32px; }
    .name { font-size: 19px; }
    dd { font-size: 17px; }
    .testimonials { padding-inline: 20px; }
  }
</style>
