---
// Type-led hero: the Calm Money wordmark with the ring as the O, surrounded by
// Peter's handwritten margin notes. Notes are transparent PNGs used as CSS masks,
// so their colour comes from the palette (graphite, or terracotta for key notes).
import Logo from './Logo.astro';
import PressStrip from './PressStrip.astro';

// Left of the wordmark: what gets cleared. Right: what gets built. Bottom right: where it leads
const notes = [
  { file: 'sub42', ar: 3.252, cls: 'sub' },
  { file: 'apr22', ar: 6.053, cls: 'apr' },
  { file: 'overdraft', ar: 4.738, cls: 'overdraft' },
  { file: 'payday', ar: 4.075, cls: 'payday' },
  { file: 'isa', ar: 2.478, cls: 'isa' },
  { file: 'ten-k', ar: 2.449, cls: 'tenk' },
  { file: 'peace6', ar: 3.533, cls: 'peace key' },
];
// These sit on the hero's bottom edge, beside the arrow, below the press strip
const bottomNotes = ['peace key'];
---
<section class="hero">
  <!-- The notes are placed by percentage of this stage, so adding the press strip below leaves them where they were -->
  <div class="stage">
  <p class="kicker"><span>You earn well.</span> <span>Now build the system that gets you investing.</span></p>
  <h1>
    <span class="sr-only">Calm Money</span>
    <span class="word" aria-hidden="true">Calm</span>
    <span class="word" aria-hidden="true">M<span class="slot"><Logo size={100} title="" /></span><span class="kern-n">n</span><span class="kern-e">e</span>y</span>
  </h1>
  <p class="byline">A programme by Peter Komolafe</p>

  {notes.filter((n) => !bottomNotes.includes(n.cls)).map((n) => (
    <span class={`note ${n.cls}`} style={`--src: url(/images/notes/${n.file}.png); --ar: ${n.ar}`} aria-hidden="true" />
  ))}
  </div>

  <PressStrip />

  {notes.filter((n) => bottomNotes.includes(n.cls)).map((n) => (
    <span class={`note ${n.cls}`} style={`--src: url(/images/notes/${n.file}.png); --ar: ${n.ar}`} aria-hidden="true" />
  ))}
  <a class="arrow" href="#for-you" aria-label="Is this for you?"><span class="note key arrow-ink" style="--src: url(/images/notes/arrow.png); --ar: 0.414" aria-hidden="true" /></a>
</section>

<script>
  // Size the ring to exactly the font's cap height (never larger), keeping the O's own side spacing.
  const fit = () => {
    const slot = document.querySelector<HTMLElement>('.hero .slot');
    if (!slot) return;
    const svg = slot.querySelector<SVGElement>('svg')!;
    const cs = getComputedStyle(slot.parentElement!);
    const ctx = document.createElement('canvas').getContext('2d')!;
    ctx.font = `${cs.fontWeight} ${cs.fontSize} ${cs.fontFamily}`;
    const cap = ctx.measureText('H').actualBoundingBoxAscent;
    const o = ctx.measureText('O');
    // The slot takes the O's full advance, tracking included (the inline-block gets none of its own),
    // and the ring sits on the centre of the O's ink, so MONEY keeps the typeface's own spacing
    const tracking = parseFloat(cs.letterSpacing) || 0;
    const slotW = o.width + tracking;
    const inkCentre = (o.actualBoundingBoxRight - o.actualBoundingBoxLeft) / 2;
    const svgS = cap / 0.822; // the ring's outer diameter is 82.2% of its viewBox
    Object.assign(slot.style, { width: `${slotW}px`, height: `${cap}px` });
    Object.assign(svg.style, { width: `${svgS}px`, height: `${svgS}px`, left: `${inkCentre - svgS / 2}px`, bottom: `${-(svgS - cap) / 2}px` });
    slot.classList.add('ready');
  };
  document.fonts.ready.then(fit);
  window.addEventListener('resize', fit);
</script>

<style>
  .hero { position: relative; text-align: center; padding: 0 0 8vw; overflow: hidden; }
  /* Same box the notes were placed in before the strip: its bottom padding is overlapped by the strip */
  .stage { position: relative; padding: 3vw 0 8vw; margin-bottom: -6vw; }
  .kicker { font-family: var(--font-display); font-size: clamp(1.25rem, 2.4vw, 2.1rem); line-height: 1.25; margin: 0 0 1.4vw; padding: 0 16px; text-wrap: balance; }
  h1 { margin: 0; font-family: var(--font-body); font-weight: 450; color: var(--teal); letter-spacing: 0; }
  /* The cards' lift, applied to the letters and ring: near, mid and far shadows, sized in em so they scale with the wordmark */
  .word { filter: drop-shadow(0 0.012em 0.016em rgb(31 38 36 / 0.10)) drop-shadow(0 0.04em 0.07em rgb(31 38 36 / 0.12)) drop-shadow(0 0.11em 0.16em rgb(31 38 36 / 0.14)); }
  /* About a third smaller than the first build (23vw), with tighter tracking */
  .word { display: block; text-transform: uppercase; font-size: 15.6vw; line-height: 0.9; letter-spacing: -0.04em; padding-right: 0.04em; /* re-centre: tracking also trims after the last letter */ }
  /* Placeholder width until the script measures the font; ring hidden until sized */
  .slot { display: inline-block; position: relative; width: 0.75em; height: 0.7em; }
  .slot :global(svg) { position: absolute; visibility: hidden; }
  .slot.ready :global(svg) { visibility: visible; }
  /* Hand kerning: N and E have flat upright strokes, which the font spaces wider than CALM's letters */
  .kern-n { margin-left: -0.045em; }
  .kern-e { margin-left: -0.062em; }
  .byline { font-family: var(--font-display); font-size: clamp(1.1rem, 1.8vw, 1.6rem); margin: 2.4vw 0 0; }

  .note { position: absolute; z-index: 1; aspect-ratio: var(--ar); background: var(--graphite); pointer-events: none;
          -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat; }
  .note.key { background: var(--terracotta); }
  .sub       { width: 15vw;  left: 7%;    top: 19%;   rotate: -4deg; }
  .apr       { width: 16.5vw; left: 5%;    top: 45%;   rotate: -3deg; }
  .overdraft { width: 14vw;  left: 7%;    top: 74.5%; rotate: -2deg; } /* just below the line of MONEY */ /* just below the line of MONEY */
  .payday    { width: 16vw;  right: 6%;   top: 20%;   rotate: 3deg; }
  .isa       { width: 9.5vw; right: 10%;  top: 44%;   rotate: -3deg; }
  .tenk      { width: 12vw;  right: 8%;   top: 66%;   rotate: 4deg; }
  .peace   { width: 14vw;  right: 4%;   bottom: 2.5%; rotate: -3deg; }

  /* Peter's hand-drawn arrow, leading down to the calculator */
  .arrow { position: absolute; left: 50%; bottom: 0.6vw; width: 1.9vw; min-width: 18px; translate: -50% 0; }
  .arrow .arrow-ink { position: static; display: block; width: 100%; }

  @media (max-width: 760px) {
    .word { font-size: 17vw; }
    .kicker { margin-bottom: 4vw; }
    .kicker span { display: block; } /* one sentence per line on phones */
    .hero { padding-bottom: 26vw; } /* room for the arrow and note below the press strip */
    .stage { margin-bottom: -5vw; }
    .sub, .apr, .overdraft, .payday, .isa, .tenk { display: none; }
    .peace { width: 36vw; right: 5%; bottom: 5%; }
    .arrow { width: 7vw; left: 22%; bottom: 3vw; }
  }
</style>
