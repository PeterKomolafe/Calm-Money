---
// Headline-led hero: the promise in the heading font with a hand-drawn underline under the payoff,
// framed by Peter's handwritten margin notes. Notes are transparent PNGs used as CSS masks,
// so their colour comes from the palette (graphite, or terracotta for key notes).
import PressStrip from './PressStrip.astro';
import PeterByline from './PeterByline.astro';

// Left of the headline: what gets cleared. Right: what gets built. Bottom right: where it leads
const notes = [
  { file: 'sub42', ar: 3.252, cls: 'sub' },
  { file: 'apr22', ar: 6.053, cls: 'apr' },
  { file: 'overdraft', ar: 4.738, cls: 'overdraft' },
  { file: 'payday', ar: 4.075, cls: 'payday' },
  { file: 'isa', ar: 2.478, cls: 'isa' },
  { file: 'ten-k', ar: 2.449, cls: 'tenk' },
  { file: 'peace6', ar: 3.533, cls: 'peace key' },
];
---
<section class="hero">
  <div class="stage">
    <h1><span>Clear debt.</span> <span>Build a safety net.</span> <span>Start investing.</span></h1>
    <p class="tagline">For people who earn well <span>but still feel <em class="stroke">stressed</em> about&nbsp;money.</span></p>
    <div class="actions">
      <a class="btn btn--primary" href="#pricing">Join Calm Money <span aria-hidden="true">→</span></a>
      <PeterByline />
    </div>
    <PressStrip tone="mono" />

    {notes.map((n) => (
      <span class={`note ${n.cls}`} style={`--src: url(/images/notes/${n.file}.png); --ar: ${n.ar}`} aria-hidden="true" />
    ))}
  </div>
  <a class="arrow" href="#for-you" aria-label="Is this for you?"><span class="note key arrow-ink" style="--src: url(/images/notes/arrow.png); --ar: 0.414" aria-hidden="true" /></a>
</section>

<style>
  .hero { position: relative; text-align: center; overflow: hidden; }
  /* The notes are placed by percentage of this stage */
  .stage { position: relative; display: grid; justify-items: center; padding: 5vw 16px 9vw; }
  h1 {
    margin: 0; max-width: 12em; font-size: clamp(2.5rem, 4.6vw, 4.6rem); line-height: 1.04;
    letter-spacing: var(--track-display); color: var(--teal-dark); text-wrap: balance;
  }
  /* Hand-drawn terracotta stroke under the payoff */
  h1 span { display: block; }
  h1:has(span) { max-width: none; }
  .tagline { margin: 1.6vw 0 0; max-width: 30em; font-size: clamp(1.25rem, 1.9vw, 1.75rem); line-height: 1.3;
         font-weight: var(--w-medium); letter-spacing: var(--track-heading); color: var(--teal-dark); text-wrap: balance; }
  .tagline em { font-style: normal; }
  h1 em { font-style: normal; } /* the stroke itself is .stroke in global.css */
  .actions { display: flex; flex-wrap: wrap; justify-content: center; align-items: center; gap: 20px 3.6vw; margin: 4.4vw 0 2.8vw; }
  .actions .btn { gap: 0.6em; }
  .actions :global(.peter-byline) { font-size: clamp(1rem, 1.2vw, 1.15rem); font-weight: var(--w-medium); }

  .note { position: absolute; z-index: 1; aspect-ratio: var(--ar); background: var(--graphite); pointer-events: none;
          -webkit-mask: var(--src) center / contain no-repeat; mask: var(--src) center / contain no-repeat; }
  .note.key { background: var(--terracotta); }
  .sub       { width: 15vw;  left: 10%;   top: 12%;   rotate: -4deg; }
  .apr       { width: 15.5vw; left: 4%;    top: 42%;   rotate: -3deg; }
  .overdraft { width: 13.5vw; left: 5.5%;  top: 70%;   rotate: -2deg; }
  .payday    { width: 16vw;  right: 9%;   top: 13%;   rotate: 3deg; }
  .isa       { width: 9.5vw; right: 10%;  top: 42%;   rotate: -3deg; }
  .tenk      { width: 12vw;  right: 8%;   top: 64%;   rotate: 4deg; }
  .peace     { width: 14vw;  right: 4%;   bottom: 2%; rotate: -3deg; }

  /* Peter's hand-drawn arrow, leading down to the next section */
  .arrow { position: absolute; z-index: 2; left: 50%; bottom: 1.2vw; width: 1.9vw; min-width: 18px; translate: -50% 0; }
  .arrow .arrow-ink { position: static; display: block; width: 100%; }

  @media (max-width: 760px) {
    .stage { padding: 10vw 24px 30vw; }
    h1 { font-size: 9.2vw; }
    .tagline { margin-top: 5vw; font-size: 1.2rem; }
    .tagline span { display: block; }
    .actions { flex-direction: column; gap: 8vw; margin: 9vw 0 7vw; }
    .actions :global(.peter-byline) { font-size: min(1.05rem, 4.6vw); }
    .sub, .apr, .overdraft, .payday, .isa, .tenk { display: none; }
    .peace { width: 36vw; right: 6%; bottom: 6vw; }
    .arrow { width: 7vw; left: 22%; bottom: 3vw; }
  }
</style>
